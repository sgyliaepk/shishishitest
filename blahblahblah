function UI.flingVoid.disconnectTouches()
    for _, connection in ipairs(UI.flingVoid.connections) do
        connection:Disconnect()
    end
    table.clear(UI.flingVoid.connections)
end

function UI.flingVoid.flingPlayer(player)
    if UI.flingVoid.running or not UI.flingVoid.enabled or flingActive or impactState.running then
        return
    end

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local targetCharacter = player and player.Character
    local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
    local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root or not targetHumanoid or targetHumanoid.Health <= 0 or not targetRoot then
        return
    end

    UI.flingVoid.running = true
    UI.flingVoid.token = UI.flingVoid.token + 1
    local token = UI.flingVoid.token

    task.spawn(function()
        local savedCFrame = root.CFrame
        local savedLinearVelocity = root.AssemblyLinearVelocity
        local savedAngularVelocity = root.AssemblyAngularVelocity
        local savedAutoRotate = humanoid.AutoRotate
        local savedPlatformStand = humanoid.PlatformStand
        local savedDestroyHeight = workspace.FallenPartsDestroyHeight
        local ownCollision = {}
        local targetCollision = {}

        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                ownCollision[part] = part.CanCollide
                part.CanCollide = part == root
            end
        end
        for _, part in ipairs(targetCharacter:GetDescendants()) do
            if part:IsA("BasePart") then
                targetCollision[part] = part.CanCollide
                part.CanCollide = true
            end
        end

        workspace.FallenPartsDestroyHeight = 0/0
        pcall(function()
            if sethiddenproperty then
                sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
            end
        end)
        humanoid.AutoRotate = false
        humanoid.PlatformStand = true
        humanoid:ChangeState(Enum.HumanoidStateType.Physics)

        local startedAt = os.clock()
        local frame = 0
        while UI.flingVoid.enabled
            and token == UI.flingVoid.token
            and LocalPlayer.Character == character
            and player.Parent == Players
            and targetCharacter == player.Character
            and targetRoot.Parent
            and targetHumanoid.Health > 0
            and os.clock() - startedAt < 1.35
        do
            frame = frame + 1
            local targetVelocity = targetRoot.AssemblyLinearVelocity
            local predictionTime = math.clamp(smoothedPing + 1 / 30, 0.04, 0.2)
            local predictedPosition = targetRoot.Position + Vector3.new(
                targetVelocity.X,
                0,
                targetVelocity.Z
            ) * predictionTime
            local contactOffset = frame % 2 == 0 and 0.08 or -0.08
            root.CFrame = CFrame.new(
                predictedPosition + Vector3.new(contactOffset, 0.7, 0)
            )
            root.AssemblyLinearVelocity = Vector3.new(0, -1000000000, 0)
            root.AssemblyAngularVelocity = Vector3.new(0, 100000000, 0)
            pcall(function()
                targetRoot.AssemblyLinearVelocity = Vector3.new(0, -1000000000, 0)
            end)
            RunService.Heartbeat:Wait()
        end

        for part, canCollide in pairs(targetCollision) do
            if part.Parent then
                part.CanCollide = canCollide
            end
        end
        for part, canCollide in pairs(ownCollision) do
            if part.Parent then
                part.CanCollide = canCollide
            end
        end

        workspace.FallenPartsDestroyHeight = antiVoidEnabled and 0/0 or savedDestroyHeight
        if root.Parent and LocalPlayer.Character == character then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = savedCFrame + Vector3.new(0, 3, 0)
            humanoid.PlatformStand = savedPlatformStand
            humanoid.AutoRotate = savedAutoRotate
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            task.defer(function()
                if root.Parent then
                    root.AssemblyLinearVelocity = savedLinearVelocity
                    root.AssemblyAngularVelocity = savedAngularVelocity
                end
            end)
        end

        UI.flingVoid.running = false
    end)
end

function UI.flingVoid.onTouched(part)
    if not UI.flingVoid.enabled or UI.flingVoid.running or not part then
        return
    end

    local targetCharacter = part:FindFirstAncestorOfClass("Model")
    local player = targetCharacter and Players:GetPlayerFromCharacter(targetCharacter)
    if not player or player == LocalPlayer then
        return
    end

    local now = os.clock()
    if now - (UI.flingVoid.hitCooldown[player] or 0) < 1.5 then
        return
    end
    UI.flingVoid.hitCooldown[player] = now
    UI.flingVoid.flingPlayer(player)
end

function UI.flingVoid.wireCharacter(character)
    for _, descendant in ipairs(character:GetDescendants()) do
        if descendant:IsA("BasePart") then
            table.insert(UI.flingVoid.connections, descendant.Touched:Connect(UI.flingVoid.onTouched))
        end
    end
    table.insert(UI.flingVoid.connections, character.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("BasePart") then
            table.insert(UI.flingVoid.connections, descendant.Touched:Connect(UI.flingVoid.onTouched))
        end
    end))
end

function UI.flingVoid.toggle(state)
    UI.flingVoid.enabled = state == true
    UI.flingVoid.token = UI.flingVoid.token + 1
    UI.flingVoid.disconnectTouches()
    table.clear(UI.flingVoid.hitCooldown)

    if not UI.flingVoid.enabled then
        return
    end

    if LocalPlayer.Character then
        UI.flingVoid.wireCharacter(LocalPlayer.Character)
    end
end

table.insert(connections, LocalPlayer.CharacterAdded:Connect(function(character)
    if UI.flingVoid.enabled then
        UI.flingVoid.disconnectTouches()
        UI.flingVoid.wireCharacter(character)
    end
end))

