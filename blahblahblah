local function createToggleWithKeybind(tab, toggleOptions)
    local toggle = tab:CreateToggle(toggleOptions)

    local keybindName = (toggleOptions.Name:gsub("^Show ", ""):gsub("^Enable ", "")) .. " Keybind"
    local keybind = tab:CreateKeybind({
        Name = keybindName,
        CurrentKeybind = "None",
        CallOnChange = true,
        Callback = function(Key)
            local entry = keybindRegistry[keybindName]
            if entry then
                entry.key = tostring(Key)
            end
        end,
    })
    keybindRegistry[keybindName] = {
        keybind = keybind,
        key = "None",
        action = function()
            toggle:Set(not toggle.CurrentValue)
        end,
    }

    return toggle
end

if not keybindPressedConn then
    keybindPressedConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if input.KeyCode == Enum.KeyCode.Escape then
            if lastKeybindBoxName and lastReleaseTime and (tick() - lastReleaseTime) < 1 then
                local entry = keybindRegistry[lastKeybindBoxName]
                if entry then
                    entry.keybind:Set("None")
                end
            end
            lastKeybindBoxName = nil
            lastReleaseTime = nil
            return
        end

        if gameProcessed then return end
        if UserInputService:GetFocusedTextBox() then return end

        local pressed = input.KeyCode
        for _, entry in pairs(keybindRegistry) do
            local keyName = entry.key
            if keyName and keyName ~= "None" then
                if pressed == Enum.KeyCode[keyName] then
                    entry.action()
                end
            end
        end
    end)
    table.insert(connections, keybindPressedConn)
end

