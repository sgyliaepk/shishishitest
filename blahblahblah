local CONFIG_FOLDER = "MARI_HUB_CONFIGS/"
local CONFIG_AUTOLOAD_FILE = "MARI_HUB_AUTOLOAD.txt"

local keybindRegistry = {}

local function ensureConfigFolder()
    if makefolder then
        pcall(function()
            makefolder(CONFIG_FOLDER)
        end)
    end
end

local function sanitizeConfigName(name)
    return tostring(name or ""):gsub("[^%w %-]", ""):gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
end

local function getConfigPath(name)
    return CONFIG_FOLDER .. name .. ".json"
end

local function listConfigs()
    local names = {}
    if listfiles then
        local success, files = pcall(function()
            return listfiles(CONFIG_FOLDER)
        end)
        if success then
            for _, file in ipairs(files) do
                local fileName = file:gsub("^.*[\\/]", "")
                local name = fileName:gsub("%.json$", "")
                if name ~= "" and fileName ~= name then
                    table.insert(names, name)
                end
            end
        end
    end
    table.sort(names)
    return names
end

local function refreshConfigDropdowns()
    local configs = listConfigs()
    if UI.configDropdown then
        pcall(function()
            UI.configDropdown:Refresh(configs, true)
        end)
    end
    if UI.autoLoadDropdown then
        pcall(function()
            UI.autoLoadDropdown:Refresh(configs, true)
        end)
    end
end

