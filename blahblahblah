        hpM2CooldownEnabled = UI.hpM2Cooldown.enabled,
        infCamZoomEnabled = UI.infCamZoom.enabled,
        jetpackEnabled = jetpack.enabled,
        flingVoidEnabled = UI.flingVoid.enabled,
        clickSpectateEnabled = UI.clickSpectate.enabled,
        autoGreenEnabled = UI.autoGreen.enabled,
        autoPianoEnabled = UI.autoPiano.enabled,
