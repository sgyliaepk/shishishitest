            function tab:CreateSlider(options)
                options = options or {}
                local minimum = tonumber(options.Range and options.Range[1]) or 0
                local maximum = tonumber(options.Range and options.Range[2]) or 100
                local increment = tonumber(options.Increment) or 1
                local control = {CurrentValue = tonumber(options.CurrentValue) or minimum}
                local card, _, detail = makeCard(options.Name or "Slider", options.Description, 72)
                detail.Visible = false
                local valueLabel = new("TextLabel", {
                    AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -15, 0, 11),
                    Size = UDim2.fromOffset(55, 18), BackgroundTransparency = 1,
                    Font = Enum.Font.GothamSemibold, Text = tostring(control.CurrentValue),
                    TextColor3 = palette.accent, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right,
                    Parent = card,
                })
                local track = new("Frame", {
                    Position = UDim2.fromOffset(14, 48), Size = UDim2.new(1, -28, 0, 5),
                    BackgroundColor3 = Color3.fromRGB(46, 52, 65), BorderSizePixel = 0, Parent = card,
                })
                corner(track, 3)
                local fill = new("Frame", {Size = UDim2.fromScale(0, 1), BackgroundColor3 = palette.accent, BorderSizePixel = 0, Parent = track})
                corner(fill, 3)
                local knob = new("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5),
                    Size = UDim2.fromOffset(13, 13), BackgroundColor3 = palette.text, BorderSizePixel = 0, Parent = track,
                })
                corner(knob, 7)
                stroke(knob, palette.accent, 0)
                local draggingSlider = false
                local function render(value, animate)
                    local ratio = maximum == minimum and 0 or (value - minimum) / (maximum - minimum)
                    local properties = {Size = UDim2.fromScale(ratio, 1)}
                    local knobProperties = {Position = UDim2.fromScale(ratio, 0.5)}
                    if animate then tween(fill, 0.1, properties); tween(knob, 0.1, knobProperties)
                    else fill.Size = properties.Size; knob.Position = knobProperties.Position end
                    valueLabel.Text = tostring(value)
                end
                function control:Set(value)
                    value = math.clamp(tonumber(value) or minimum, minimum, maximum)
                    value = math.floor((value - minimum) / increment + 0.5) * increment + minimum
                    value = math.clamp(value, minimum, maximum)
                    if self.CurrentValue == value then render(value, true); return end
                    self.CurrentValue = value
                    render(value, true)
                    invoke(options.Callback, value)
                end
                local hitbox = new("TextButton", {
                    Position = UDim2.fromOffset(-5, -8), Size = UDim2.new(1, 10, 1, 16),
                    BackgroundTransparency = 1, Text = "", Parent = track,
                })
                local function updateFromPosition(position)
                    control:Set(minimum + math.clamp((position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1) * (maximum - minimum))
                end
                connect(hitbox.InputBegan, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        draggingSlider = true; updateFromPosition(input.Position)
                    end
                end, window.connections)
                connect(UserInputService.InputChanged, function(input)
                    if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        updateFromPosition(input.Position)
                    end
                end, window.connections)
                connect(UserInputService.InputEnded, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingSlider = false end
                end, window.connections)
                render(control.CurrentValue, false)
                return control
            end

            function tab:CreateDropdown(options)
                options = options or {}
                local control = {CurrentOption = options.CurrentOption or "", Options = options.Options or {}, open = false}
                local optionConnections = {}
                local card = makeCard(options.Name or "Dropdown", options.Description, 64)
                local selector = new("TextButton", {
