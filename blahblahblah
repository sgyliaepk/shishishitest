startFlingMonitor = function()
    if flingMonitorConn then
        return
    end
    flingMonitorConn = RunService.Heartbeat:Connect(function()
        if not flingActive and not flingWasActive then
            return
        end
        local char = LocalPlayer.Character
        if not char then
            stopFlingMonitor()
            return
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local dead = hum and hum.Health <= 0

        if dead then
            if not flingDeathActive then
                flingDeathActive = true
                deathChar = char
                if flingActive then
                    flingWasActive = true
                    stopFlingOnDeath()
                end
            end
        else
            if flingDeathActive then
                flingDeathActive = false
                if deathChar == char and flingWasActive then
                    flingWasActive = false
                    flingActive = true
                    startFlingLoop()
                else
                    flingWasActive = false
