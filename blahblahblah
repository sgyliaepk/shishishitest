-- ===== NO BLUR =====
function UI.noBlur.suppress(root)
    if not root then return end

    for _, effect in ipairs(root:GetDescendants()) do
        if effect:IsA("BlurEffect") or effect:IsA("DepthOfFieldEffect") then
            if UI.noBlur.states[effect] == nil or effect.Enabled then
                UI.noBlur.states[effect] = effect.Enabled
            end
            effect.Enabled = false
        end
    end
end

function UI.noBlur.step()
    UI.noBlur.suppress(game:GetService("Lighting"))
    UI.noBlur.suppress(workspace.CurrentCamera)
end

function UI.noBlur.toggle(state)
    UI.noBlur.enabled = state == true

    if UI.noBlur.connection then
        UI.noBlur.connection:Disconnect()
        UI.noBlur.connection = nil
    end

    if not UI.noBlur.enabled then
        for effect, enabled in pairs(UI.noBlur.states) do
            if effect.Parent then
                effect.Enabled = enabled
            end
        end
        table.clear(UI.noBlur.states)
        return
    end

    UI.noBlur.step()
    UI.noBlur.connection = RunService.RenderStepped:Connect(UI.noBlur.step)
end

