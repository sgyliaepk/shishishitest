function UI.chatLogger.append(speaker, message)
    local body = UI.chatLogger.body
    if not UI.chatLogger.enabled or not body or not body.Parent then
        return
    end

    local label = Instance.new("TextLabel")
    label.Name = "Message"
    label.Size = UDim2.new(1, -4, 0, 18)
    label.AutomaticSize = Enum.AutomaticSize.Y
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.Gotham
    label.Text = string.format("%s: %s", tostring(speaker), tostring(message))
    label.TextColor3 = Color3.fromRGB(216, 216, 222)
    label.TextSize = 11
    label.TextWrapped = true
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Top
    label.ZIndex = 62
    label.Parent = body

    task.defer(function()
        if body.Parent then
            body.CanvasPosition = Vector2.new(0, math.max(0, body.AbsoluteCanvasSize.Y))
        end
    end)
end

function UI.chatLogger.wireLegacyPlayer(player)
    table.insert(UI.chatLogger.connections, player.Chatted:Connect(function(message)
        UI.chatLogger.append(player.Name, message)
    end))
end

function UI.chatLogger.toggle(state)
    UI.chatLogger.disconnect()
    UI.chatLogger.destroyGui()
    UI.chatLogger.enabled = state == true
    if not UI.chatLogger.enabled then
        return
    end

    UI.chatLogger.createGui()
    local textChatService = game:GetService("TextChatService")
    if textChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        table.insert(UI.chatLogger.connections, textChatService.MessageReceived:Connect(function(message)
            local source = message.TextSource
            if not source then return end
            local player = Players:GetPlayerByUserId(source.UserId)
            UI.chatLogger.append(player and player.Name or source.Name, message.Text)
        end))
