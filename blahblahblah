function UI.walkSpeed.cleanup(restoreOriginal)
    UI.walkSpeed.token = UI.walkSpeed.token + 1
    for _, connection in ipairs(UI.walkSpeed.connections) do
        connection:Disconnect()
    end
    table.clear(UI.walkSpeed.connections)

    local humanoid = UI.walkSpeed.humanoid
    if restoreOriginal and humanoid and humanoid.Parent and UI.walkSpeed.originalSpeed then
        UI.walkSpeed.changingSpeed = true
        humanoid.WalkSpeed = UI.walkSpeed.originalSpeed
        UI.walkSpeed.changingSpeed = false
    end

    UI.walkSpeed.humanoid = nil
    UI.walkSpeed.originalSpeed = nil
end

function UI.walkSpeed.applyCharacter(character)
    UI.walkSpeed.cleanup(false)
    UI.walkSpeed.token = UI.walkSpeed.token + 1
    local token = UI.walkSpeed.token
    local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
    if not humanoid or token ~= UI.walkSpeed.token or not UI.walkSpeed.enabled then
        return
    end

    UI.walkSpeed.humanoid = humanoid
    UI.walkSpeed.originalSpeed = humanoid.WalkSpeed

    local function updateSpeed()
        if not humanoid.Parent or not UI.walkSpeed.enabled then return end
        UI.walkSpeed.changingSpeed = true
        humanoid.WalkSpeed = UI.walkSpeed.value
        UI.walkSpeed.changingSpeed = false
    end

    table.insert(UI.walkSpeed.connections, humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if UI.walkSpeed.enabled
            and not UI.walkSpeed.changingSpeed
            and humanoid.WalkSpeed ~= UI.walkSpeed.value
        then
            updateSpeed()
        end
    end))
    updateSpeed()
end

function UI.walkSpeed.setEnabled(value)
