-- ===== AUTO CHESS =====
function UI.autoChess.findContext()
    if UI.autoChess.context
        and type(UI.autoChess.state) == "table"
        and rawget(UI.autoChess.context, "Chess") == UI.autoChess.state
    then
        return UI.autoChess.context, UI.autoChess.state
    end

    if typeof(getgc) ~= "function" then
        return nil, nil
    end
    for _, candidate in ipairs(getgc(true)) do
        if type(candidate) == "table" then
            local chessState = rawget(candidate, "Chess")
            if type(chessState) == "table"
                and type(rawget(chessState, "handle")) == "function"
                and typeof(candidate.Invoke) == "function"
            then
                UI.autoChess.context = candidate
                UI.autoChess.state = chessState
                return candidate, chessState
            end
        end
    end
    return nil, nil
end

function UI.autoChess.search(state, depth, alpha, beta, ply)
    UI.autoChess.nodes = UI.autoChess.nodes + 1
    if UI.autoChess.nodes % 96 == 0 then
        task.wait()
    end

    local legalMoves = UI.autoChess.moves.legal(state)
    if #legalMoves == 0 then
        if UI.autoChess.moves.inCheck(state, state.side) then
            if state.side == "w" then
                return -100000 + ply
            end
            return 100000 - ply
        end
        return 0
    end
    if depth <= 0 then
        return UI.autoChess.eval.score(state)
    end

    if state.side == "w" then
        local best = -math.huge
        for _, move in ipairs(legalMoves) do
            local _, undo = UI.autoChess.moves.make(state, move)
            local score = UI.autoChess.search(state, depth - 1, alpha, beta, ply + 1)
            UI.autoChess.moves.unmake(state, move, undo)
            best = math.max(best, score)
            alpha = math.max(alpha, score)
            if alpha >= beta then break end
        end
        return best
    end

    local best = math.huge
    for _, move in ipairs(legalMoves) do
        local _, undo = UI.autoChess.moves.make(state, move)
        local score = UI.autoChess.search(state, depth - 1, alpha, beta, ply + 1)
        UI.autoChess.moves.unmake(state, move, undo)
        best = math.min(best, score)
        beta = math.min(beta, score)
        if alpha >= beta then break end
    end
    return best
end

function UI.autoChess.chooseMove(state)
    UI.autoChess.nodes = 0
    local legalMoves = UI.autoChess.moves.legal(state)
    local bestMove
    local bestScore = state.side == "w" and -math.huge or math.huge

    for _, move in ipairs(legalMoves) do
        local _, undo = UI.autoChess.moves.make(state, move)
        local score = UI.autoChess.search(state, 2, -math.huge, math.huge, 1)
        UI.autoChess.moves.unmake(state, move, undo)

        if not bestMove
            or state.side == "w" and score > bestScore
            or state.side == "b" and score < bestScore
        then
            bestMove = move
            bestScore = score
        end
    end
    return bestMove
end

function UI.autoChess.step()
    if not UI.autoChess.enabled or UI.autoChess.searching or os.clock() < UI.autoChess.nextScan then
        return
    end
    UI.autoChess.nextScan = os.clock() + 0.2

    local context, chessState = UI.autoChess.findContext()
    local mirror = chessState and chessState.mirror
    if not context or not chessState.active or not chessState.seated or not mirror then
        UI.autoChess.lastFen = nil
        return
    end

    local turnColor = mirror:turn() == "white" and "w" or "b"
    if not chessState.solo and turnColor ~= chessState.myColor then
        return
    end

    local fen = mirror:fen()
    if UI.autoChess.lastFen == fen then
        return
    end
    UI.autoChess.lastFen = fen
    UI.autoChess.searching = true

    task.spawn(function()
        local searchEngine = mirror:clone()
        local success, move = pcall(UI.autoChess.chooseMove, searchEngine.state)
        if success
            and move
            and UI.autoChess.enabled
            and chessState.active
            and chessState.mirror
            and chessState.mirror:fen() == fen
        then
            success = pcall(function()
                context:Invoke("Chess_Move", {
                    tableId = chessState.tableId,
                    from = move.from,
                    to = move.to,
                    promo = move.promo and move.promo:lower() or nil,
                })
            end)
        end
        if not success then
            UI.autoChess.lastFen = nil
        end
        UI.autoChess.searching = false
    end)
end

function UI.autoChess.toggle(state)
    UI.autoChess.enabled = state == true
    UI.autoChess.searching = false
    UI.autoChess.lastFen = nil
    UI.autoChess.nextScan = 0
    UI.autoChess.context = nil
    UI.autoChess.state = nil

    if UI.autoChess.connection then
        UI.autoChess.connection:Disconnect()
        UI.autoChess.connection = nil
    end
    if not UI.autoChess.enabled then
        return
    end

    local success, moves, evaluation = pcall(function()
        local chess = ReplicatedStorage.Shared.Chess
        return require(chess.Moves), require(chess.Eval)
    end)
    if not success then
        UI.autoChess.enabled = false
        createNotification("Auto Chess", "Chess engine modules are unavailable.")
        task.defer(function()
            if UI.autoChessToggle then
                UI.autoChessToggle:Set(false)
            end
        end)
        return
    end

    UI.autoChess.moves = moves
    UI.autoChess.eval = evaluation
    UI.autoChess.connection = RunService.Heartbeat:Connect(UI.autoChess.step)
end

