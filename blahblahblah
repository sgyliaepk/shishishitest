        function window:SetAccent(color)
            if typeof(color) ~= "Color3" then return end
            local previousAccent = palette.accent
            local previousSoft = palette.accentSoft
            local nextSoft = palette.surface:Lerp(color, 0.34)

            local function remember(history, value)
                for _, savedColor in ipairs(history) do
                    if savedColor == value then return end
                end
                table.insert(history, value)
            end
            local function contains(history, value)
                for _, savedColor in ipairs(history) do
                    if savedColor == value then return true end
                end
                return false
            end
            remember(self.accentHistory, previousAccent)
            remember(self.accentHistory, color)
            remember(self.softAccentHistory, previousSoft)
            remember(self.softAccentHistory, nextSoft)

            palette.accent = color
            palette.accentSoft = nextSoft

            local function applyTheme()
                if not gui.Parent then return end
                for _, descendant in ipairs(gui:GetDescendants()) do
                    if descendant:IsA("GuiObject") then
                        if contains(self.accentHistory, descendant.BackgroundColor3) then
                            descendant.BackgroundColor3 = color
                        elseif contains(self.softAccentHistory, descendant.BackgroundColor3) then
                            descendant.BackgroundColor3 = nextSoft
                        end
                    end
                    if descendant:IsA("TextLabel")
                        or descendant:IsA("TextButton")
                        or descendant:IsA("TextBox")
                    then
                        if contains(self.accentHistory, descendant.TextColor3) then
                            descendant.TextColor3 = color
                        end
                    end
                    if descendant:IsA("ScrollingFrame")
                        and contains(self.accentHistory, descendant.ScrollBarImageColor3)
                    then
                        descendant.ScrollBarImageColor3 = color
                    elseif descendant:IsA("UIStroke")
                        and contains(self.accentHistory, descendant.Color)
                    then
                        descendant.Color = color
                    end
                end
                for _, refresh in ipairs(self.themeRefreshers) do
                    pcall(refresh, color, nextSoft)
                end
            end

            applyTheme()
            task.delay(0.24, function()
                if palette.accent == color then
                    applyTheme()
                end
            end)
        end

        function window:SetToggleKeybind(keyName)
            local key = typeof(keyName) == "EnumItem" and keyName or Enum.KeyCode[tostring(keyName)]
            if key then
