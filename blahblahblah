        flingActive = not flingActive
    else
        flingActive = newState
    end

    playSound()

    if flingToggleRef then
        flingToggleRef:Set(flingActive)
    end

    updateTargetStatusLabel()

    if flingActive then
        startFlingLoop()
    else
        stopFlingLoop()
        stopFlingMonitor()
        restoreGhostedParts()
        zeroCharacterVelocity(LocalPlayer.Character)
        task.delay(0.1, function()
            if not flingActive then
                zeroCharacterVelocity(LocalPlayer.Character)
            end
        end)
    end
end

