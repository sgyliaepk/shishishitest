local keybindPressedConn
local lastKeybindBoxName
local lastReleaseTime

local focusTrackConn1 = UserInputService.TextBoxFocused:Connect(function(tb)
    if tb and tb.Name == "KeybindBox" then
        local el = tb.Parent and tb.Parent.Parent
        if el and el.Name then
            lastKeybindBoxName = el.Name
        end
    end
end)
local focusTrackConn2 = UserInputService.TextBoxFocusReleased:Connect(function()
    lastReleaseTime = tick()
end)
table.insert(connections, focusTrackConn1)
table.insert(connections, focusTrackConn2)

local function createToggleWithKeybind(tab, toggleOptions)
    local toggle = tab:CreateToggle(toggleOptions)

    local keybindName = (toggleOptions.Name:gsub("^Show ", ""):gsub("^Enable ", "")) .. " Keybind"
    local keybind = tab:CreateKeybind({
        Name = keybindName,
        CurrentKeybind = "None",
        InlineParent = toggle.Instance,
        CallOnChange = true,
        Callback = function(Key)
            local entry = keybindRegistry[keybindName]
            if entry then
                entry.key = tostring(Key)
            end
        end,
    })
    keybindRegistry[keybindName] = {
        keybind = keybind,
        key = "None",
        action = function()
            toggle:Set(not toggle.CurrentValue)
        end,
    }

    return toggle
end

if not keybindPressedConn then
    keybindPressedConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if input.KeyCode == Enum.KeyCode.Escape then
            if lastKeybindBoxName and lastReleaseTime and (tick() - lastReleaseTime) < 1 then
                local entry = keybindRegistry[lastKeybindBoxName]
                if entry then
                    entry.keybind:Set("None")
                end
            end
            lastKeybindBoxName = nil
            lastReleaseTime = nil
            return
        end

        if gameProcessed then return end
        if UserInputService:GetFocusedTextBox() then return end

        local pressed = input.KeyCode
        for _, entry in pairs(keybindRegistry) do
            local keyName = entry.key
            if keyName and keyName ~= "None" then
                if pressed == Enum.KeyCode[keyName] then
                    entry.action()
                end
            end
        end
    end)
    table.insert(connections, keybindPressedConn)
end

-- ===== INF STAMINA =====
local function stopInfStamina()
    infStaminaEnabled = false
    if infStaminaConnection then
        infStaminaConnection:Disconnect()
        infStaminaConnection = nil
    end
end

local function startInfStamina()
    if not infStaminaEnabled or infStaminaConnection then
        return
    end

    infStaminaConnection = RunService.RenderStepped:Connect(function()
        local character = LocalPlayer.Character
        if not character then return end

        if character:GetAttribute("Stamina") ~= nil and character:GetAttribute("Stamina") < 100 then
            character:SetAttribute("Stamina", 100)
        end
    end)
end

local function toggleInfStamina(state)
    infStaminaEnabled = state
    if state then
        startInfStamina()
    else
        stopInfStamina()
    end
end

-- ===== NO DODGE COOLDOWN =====
if typeof(_G.__mariHubNoDodgeCooldownCleanup) == "function" then
    pcall(_G.__mariHubNoDodgeCooldownCleanup)
end

local function stopNoDodgeCooldown()
    noDodgeCooldownEnabled = false
    if noDodgeCooldownModule
        and noDodgeCooldownOriginal
        and noDodgeCooldownModule.Evasive == noDodgeCooldownHook
    then
        noDodgeCooldownModule.Evasive = noDodgeCooldownOriginal
    end
    noDodgeCooldownModule = nil
    noDodgeCooldownOriginal = nil
    noDodgeCooldownHook = nil
end

local function toggleNoDodgeCooldown(state)
    if not state then
        stopNoDodgeCooldown()
        return
    end

    if noDodgeCooldownEnabled and noDodgeCooldownHook then
        return
    end

    local evasive = require(ReplicatedStorage.CombatSystemClient.Combat.Base.Evasive)
    local original = evasive.Evasive
    local setupValue = debug and debug.setupvalue or setupvalue
    if typeof(original) ~= "function" or typeof(setupValue) ~= "function" then
        createNotification("No Dodge Cooldown", "Unsupported executor debug library.")
        if UI.noDodgeCooldownToggle then
            task.defer(function()
                UI.noDodgeCooldownToggle:Set(false)
            end)
        end
        return
    end

    noDodgeCooldownEnabled = true
    noDodgeCooldownModule = evasive
    noDodgeCooldownOriginal = original
    noDodgeCooldownHook = function(...)
        if noDodgeCooldownEnabled then
            local character = LocalPlayer.Character
            if character then
                character:SetAttribute("IFRAMECD", nil)
                character:SetAttribute("EvasiveCooldownRemaining", nil)
            end

            -- Upvalue 4 is the Evasive module's local cooldown deadline.
            pcall(setupValue, original, 4, 0)
        end
        return original(...)
    end
    evasive.Evasive = noDodgeCooldownHook
end

_G.__mariHubNoDodgeCooldownCleanup = stopNoDodgeCooldown

