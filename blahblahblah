local function stopSpectating()
    if spectateConnection then
        spectateConnection:Disconnect()
        spectateConnection = nil
    end

    if spectateRespawnConnection then
        spectateRespawnConnection:Disconnect()
        spectateRespawnConnection = nil
    end

    spectateTarget = nil
    if UI.clickSpectate.setButtonVisible then
        UI.clickSpectate.setButtonVisible(false)
    end

    local character = LocalPlayer.Character
    if character then
        local hum = character:FindFirstChildOfClass("Humanoid")
        if hum then
            workspace.CurrentCamera.CameraSubject = hum
        end
    end

    createNotification("Spectate", "Stopped spectating.")
end

local function startSpectating(playerName)
    if playerName == "" then
        createNotification("Error", "Enter a player name.")
        return
    end

    local target

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Name:lower():sub(1,#playerName) == playerName:lower() then
            target = plr
            break
        end
    end

    if not target then
        createNotification("Error", "Player not found.")
        return
    end

    stopSpectating()

    spectateTarget = target

    local function updateCamera()
        if not spectateTarget then
            return
        end

        local char = spectateTarget.Character
        if not char then
            return
        end

        local hum = char:FindFirstChildOfClass("Humanoid")

        if hum then
            workspace.CurrentCamera.CameraSubject = hum
        end
    end

    updateCamera()

    spectateRespawnConnection = target.CharacterAdded:Connect(function()
        task.wait(0.2)
        updateCamera()
    end)

    spectateConnection = workspace.CurrentCamera:GetPropertyChangedSignal("CameraSubject"):Connect(function()
        updateCamera()
    end)

    createNotification("Spectate", "Viewing "..target.Name)
    UI.clickSpectate.setButtonVisible(true)
end

