function UI.infCamZoom.readUpvalueOfType(callback, index, expectedType)
    local getUpvalue = debug and debug.getupvalue or getupvalue
    if typeof(getUpvalue) ~= "function" then
        return nil
    end

    local success, first, second = pcall(getUpvalue, callback, index)
    if not success then
        return nil
    end
    if typeof(second) == expectedType then
        return second
    end
    if typeof(first) == expectedType then
        return first
    end
    return nil
end

function UI.infCamZoom.toggle(state, silent)
    local setUpvalue = debug and debug.setupvalue or setupvalue

    if state and UI.infCamZoom.enabled then
        return
    end

    if not state then
        if UI.infCamZoom.zoomController
            and UI.infCamZoom.originalPopper
            and typeof(setUpvalue) == "function"
        then
            pcall(setUpvalue, UI.infCamZoom.zoomController.Update, 7, UI.infCamZoom.originalPopper)
        end

        UI.infCamZoom.enabled = false
        UI.infCamZoom.zoomController = nil
        UI.infCamZoom.originalPopper = nil
        if UI.infCamZoom.savedMaxZoom ~= nil then
            LocalPlayer.CameraMaxZoomDistance = UI.infCamZoom.savedMaxZoom
            UI.infCamZoom.savedMaxZoom = nil
        end
        if not silent then
            createNotification("Inf Cam Zoom", "Disabled (restored zoom and walls)")
        end
        return
    end

    local zoomController = require(
        LocalPlayer.PlayerScripts.PlayerModule.CameraModule.ZoomController
    )
    local originalPopper = UI.infCamZoom.readUpvalueOfType(zoomController.Update, 7, "function")
    if typeof(setUpvalue) ~= "function" or not originalPopper then
        createNotification("Inf Cam Zoom", "Camera wall bypass is unsupported.")
        task.defer(function()
            if UI.infCamZoomToggle then
                UI.infCamZoomToggle:Set(false)
            end
        end)
        return
    end

    UI.infCamZoom.savedMaxZoom = UI.infCamZoom.savedMaxZoom or LocalPlayer.CameraMaxZoomDistance
    UI.infCamZoom.zoomController = zoomController
    UI.infCamZoom.originalPopper = originalPopper
    UI.infCamZoom.passthroughPopper = UI.infCamZoom.passthroughPopper or function(_, distance)
        return distance
    end

    local success = pcall(
        setUpvalue,
        zoomController.Update,
        7,
        UI.infCamZoom.passthroughPopper
    )
    if not success then
        UI.infCamZoom.zoomController = nil
        UI.infCamZoom.originalPopper = nil
        UI.infCamZoom.savedMaxZoom = nil
        createNotification("Inf Cam Zoom", "Failed to disable camera wall collision.")
        task.defer(function()
            if UI.infCamZoomToggle then
                UI.infCamZoomToggle:Set(false)
            end
        end)
        return
    end

    UI.infCamZoom.enabled = true
    LocalPlayer.CameraMaxZoomDistance = math.huge
    if not silent then
        createNotification("Inf Cam Zoom", "Enabled (infinite zoom + wall bypass)")
    end
end

