-- Modern camera-relative flight replaces the legacy body-mover implementation above.
StartFly = function()
    if flying then return end

    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
    local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 10)
    if not humanoid or not root then return end

    flying = true
    CONTROL.F = UserInputService:IsKeyDown(Enum.KeyCode.W) and 1 or 0
    CONTROL.B = UserInputService:IsKeyDown(Enum.KeyCode.S) and -1 or 0
    CONTROL.L = UserInputService:IsKeyDown(Enum.KeyCode.A) and -1 or 0
    CONTROL.R = UserInputService:IsKeyDown(Enum.KeyCode.D) and 1 or 0
    if not noclipEnabled then
        flyEnabledNoclip = true
        toggleNoclip(true, true)
    else
        flyEnabledNoclip = false
    end

    for _, name in ipairs({"MariFlyAttachment", "MariFlyVelocity", "MariFlyOrientation"}) do
        local old = root:FindFirstChild(name)
        if old then old:Destroy() end
    end

    flyHumanoid = humanoid
    flyOriginalAutoRotate = humanoid.AutoRotate
    humanoid.AutoRotate = false
    humanoid.PlatformStand = true

    flyAttachment = Instance.new("Attachment")
    flyAttachment.Name = "MariFlyAttachment"
    flyAttachment.Parent = root

    flyVelocity = Instance.new("LinearVelocity")
    flyVelocity.Name = "MariFlyVelocity"
    flyVelocity.Attachment0 = flyAttachment
    flyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    flyVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    flyVelocity.MaxForce = math.huge
    flyVelocity.VectorVelocity = Vector3.zero
    flyVelocity.Parent = root

    flyGyro = Instance.new("AlignOrientation")
    flyGyro.Name = "MariFlyOrientation"
    flyGyro.Attachment0 = flyAttachment
    flyGyro.Mode = Enum.OrientationAlignmentMode.OneAttachment
    flyGyro.RigidityEnabled = false
    flyGyro.Responsiveness = 35
    flyGyro.MaxTorque = math.huge
    flyGyro.Parent = root

    flyConnection = RunService.RenderStepped:Connect(function(deltaTime)
        if not flying
            or character ~= LocalPlayer.Character
            or not root.Parent
            or not flyVelocity
            or not flyGyro
        then
            return
        end

        local camera = workspace.CurrentCamera
        if not camera then return end
        local forward = camera.CFrame.LookVector.Unit
        local right = camera.CFrame.RightVector.Unit

        local direction = forward * (CONTROL.F + CONTROL.B)
            + right * (CONTROL.R + CONTROL.L)
        if direction.Magnitude > 1 then
            direction = direction.Unit
        end

        local targetVelocity = direction * (flySpeed * 50)
        flyVelocity.VectorVelocity = flyVelocity.VectorVelocity:Lerp(
            targetVelocity,
            math.clamp(deltaTime * 12, 0, 1)
        )
        local facing = Vector3.new(forward.X, 0, forward.Z)
        if facing.Magnitude < 0.01 then
            facing = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
        end
        if facing.Magnitude >= 0.01 then
            flyGyro.CFrame = CFrame.lookAt(Vector3.zero, facing.Unit, Vector3.yAxis)
        end
    end)
end

StopFly = function()
    flying = false

    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    if flyGyro then
        flyGyro:Destroy()
        flyGyro = nil
    end
    if flyVelocity then
        flyVelocity:Destroy()
        flyVelocity = nil
    end
    if flyAttachment then
        flyAttachment:Destroy()
        flyAttachment = nil
    end

    CONTROL = {F=0, B=0, L=0, R=0}
    if flyHumanoid and flyHumanoid.Parent then
        flyHumanoid.PlatformStand = false
        if flyOriginalAutoRotate ~= nil then
            flyHumanoid.AutoRotate = flyOriginalAutoRotate
        end
    end
    flyHumanoid = nil
    flyOriginalAutoRotate = nil

    if workspace.CurrentCamera then
        workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
    end
    if flyEnabledNoclip then
        toggleNoclip(false, true)
        flyEnabledNoclip = false
    end
end

