UI.hpM2Cooldown.module = require(ReplicatedStorage.CombatSystemClient.Combat.Base.M2)
UI.hpM2Cooldown.config = require(ReplicatedStorage.Shared.Config.CombatConfig)

function UI.hpM2Cooldown.readUpvalueOfType(callback, index, expectedType)
    local getUpvalue = debug and debug.getupvalue or getupvalue
    if typeof(getUpvalue) ~= "function" then
        return nil
    end

    local success, first, second = pcall(getUpvalue, callback, index)
    if not success then
        return nil
    end
    if typeof(second) == expectedType then
        return second
    end
    if typeof(first) == expectedType then
        return first
    end
    return nil
end

function UI.hpM2Cooldown.getDuration(character)
    local playerData = character and character:FindFirstChild("PlayerData")
    local style = playerData and playerData:GetAttribute("CombatStyle") or "default"
    return UI.hpM2Cooldown.config.GetStyleM2Cooldown(style)
end

function UI.hpM2Cooldown.getExactRemaining()
    if not UI.hpM2Cooldown.schedule then
        UI.hpM2Cooldown.schedule = UI.hpM2Cooldown.readUpvalueOfType(
            UI.hpM2Cooldown.module.OnM2Activated,
            11,
            "function"
        )
        if not UI.hpM2Cooldown.schedule then
            return nil
        end
    end

    local startedAt = UI.hpM2Cooldown.readUpvalueOfType(UI.hpM2Cooldown.schedule, 7, "number")
    local duration = UI.hpM2Cooldown.readUpvalueOfType(UI.hpM2Cooldown.schedule, 8, "number")
    if startedAt and duration then
        return math.max(0, duration - (time() - startedAt))
    end

    return nil
end

