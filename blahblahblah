        walkSpeedValue = UI.walkSpeed.value,
        noclipEnabled = noclipEnabled,
        blinkOn = blinkOn,
        blinkDist = blinkDist,
        heartAutoEnabled = _G.__heartAuto == true,
        uiColorPreset = UI.uiColorDropdown and UI.uiColorDropdown.CurrentOption or UI.colorPreset,
        uiToggleKeybind = UI.uiToggleKeybind and UI.uiToggleKeybind.CurrentKeybind or UI.toggleKeybind,
        uiRestoreButtonEnabled = UI.restoreButtonToggle ~= nil
            and UI.restoreButtonToggle.CurrentValue,
