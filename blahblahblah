                    tween(box, 0.15, {BackgroundColor3 = palette.surfaceActive, TextColor3 = palette.text})
                    task.defer(function()
                        if capture then capture:Disconnect() end
                        capture = UserInputService.InputBegan:Connect(function(input)
                            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                            local key = input.KeyCode == Enum.KeyCode.Escape and "None" or input.KeyCode.Name
                            box:ReleaseFocus()
                            control:Set(key)
                            capture:Disconnect(); capture = nil
                        end)
                        table.insert(window.connections, capture)
                    end)
                end, window.connections)
                connect(box.FocusLost, function()
                    if box.Text == "Press a key..." then box.Text = control.CurrentKeybind end
                    tween(box, 0.15, {BackgroundColor3 = palette.background, TextColor3 = palette.muted})
                end, window.connections)
                return control
            end

            if not window.selectedTab then
                window:SelectTab(tab)
