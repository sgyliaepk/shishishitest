                })
                local layout = new("UIListLayout", {Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list})

                local function selectedText(value)
                    if typeof(value) == "table" then value = value[1] end
                    if value == nil or value == "" then return "  Select..." end
                    return "  " .. tostring(value)
                end
                local function rebuild()
                    for _, connection in ipairs(optionConnections) do
                        connection:Disconnect()
                    end
                    table.clear(optionConnections)
                    for _, child in ipairs(list:GetChildren()) do
                        if child:IsA("GuiButton") then child:Destroy() end
                    end
                    for _, option in ipairs(control.Options) do
                        local value = typeof(option) == "Instance" and option.Name or tostring(option)
                        local optionButton = new("TextButton", {
                            Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = palette.background,
                            BorderSizePixel = 0, AutoButtonColor = false, Font = Enum.Font.Gotham,
                            Text = "  " .. value, TextColor3 = palette.text, TextSize = 11,
                            TextXAlignment = Enum.TextXAlignment.Left, Parent = list,
                        })
                        corner(optionButton, 7)
                        table.insert(optionConnections, optionButton.MouseEnter:Connect(function()
                            tween(optionButton, 0.14, {BackgroundColor3 = palette.surfaceActive})
                        end))
                        table.insert(optionConnections, optionButton.MouseLeave:Connect(function()
                            tween(optionButton, 0.14, {BackgroundColor3 = palette.background})
                        end))
                        table.insert(optionConnections, optionButton.Activated:Connect(function()
                            control:Set(value)
                            control.open = false
                            tween(card, 0.18, {Size = UDim2.new(1, -4, 0, 64)})
                            tween(list, 0.18, {Size = UDim2.new(1, -28, 0, 0)})
                        end))
                    end
                end
                function control:Set(value)
                    if typeof(value) == "table" then value = value[1] end
                    self.CurrentOption = value or ""
                    selector.Text = selectedText(self.CurrentOption)
                    invoke(options.Callback, self.CurrentOption)
                end
                function control:Refresh(newOptions, clearSelection)
                    self.Options = newOptions or {}
                    if clearSelection then
                        self.CurrentOption = ""
                        selector.Text = selectedText("")
                    end
                    rebuild()
                end
                connect(selector.Activated, function()
                    control.open = not control.open
                    local visibleCount = math.min(#control.Options, 6)
                    local listHeight = visibleCount * 34
                    tween(card, 0.2, {Size = UDim2.new(1, -4, 0, control.open and (70 + listHeight) or 64)})
                    tween(list, 0.2, {Size = UDim2.new(1, -28, 0, control.open and listHeight or 0)})
                end, window.connections)
                setHover(selector, selector, palette.background, palette.surfaceActive)
                rebuild()
                return control
            end

