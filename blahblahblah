-- ===== ANTI FLING =====
local antiFlingPartsByChar = {}
local antiFlingCharConnections = {}

local function onAntiFlingPartAdded(char, desc)
    if desc:IsA("BasePart") then
        if originalCanCollide[desc] == nil then
            originalCanCollide[desc] = desc.CanCollide
        end
        local list = antiFlingPartsByChar[char]
        if list then
            table.insert(list, desc)
        end
    end
end

local function wireAntiFlingCharacter(char)
    if antiFlingPartsByChar[char] then
        return
    end

    local list = {}
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if originalCanCollide[part] == nil then
                originalCanCollide[part] = part.CanCollide
            end
            table.insert(list, part)
        end
    end
    antiFlingPartsByChar[char] = list

    table.insert(antiFlingCharConnections, char.DescendantAdded:Connect(function(desc)
        onAntiFlingPartAdded(char, desc)
    end))
    table.insert(antiFlingCharConnections, char.DescendantRemoving:Connect(function(desc)
        local l = antiFlingPartsByChar[char]
        if l and desc:IsA("BasePart") then
            for i = #l, 1, -1 do
                if l[i] == desc then
                    table.remove(l, i)
                end
            end
        end
    end))
end

local function wireAntiFlingPlayer(player)
    if player == LocalPlayer then
        return
    end
    if player.Character then
        wireAntiFlingCharacter(player.Character)
    end
    table.insert(antiFlingCharConnections, player.CharacterAdded:Connect(wireAntiFlingCharacter))
end

local function clearAntiFlingWiring()
    for _, conn in ipairs(antiFlingCharConnections) do
        pcall(function()
            conn:Disconnect()
        end)
    end
    table.clear(antiFlingCharConnections)
    table.clear(antiFlingPartsByChar)
end

local function toggleAntiFling(state)
    if antiFlingConnection then
        antiFlingConnection:Disconnect()
        antiFlingConnection = nil
    end

    antiFlingEnabled = state

    if not state then
        for part, value in pairs(originalCanCollide) do
            if part and part.Parent then
                part.CanCollide = value
            end
        end

        table.clear(originalCanCollide)
        clearAntiFlingWiring()

        createNotification("Anti Fling", "Disabled")
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        wireAntiFlingPlayer(player)
    end

    table.insert(antiFlingCharConnections, Players.PlayerAdded:Connect(wireAntiFlingPlayer))

    antiFlingConnection = RunService.Stepped:Connect(function()
        for _, parts in pairs(antiFlingPartsByChar) do
            for _, part in ipairs(parts) do
                if part and part.Parent and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end)

    createNotification("Anti Fling", "Enabled")
end

