        function window:SetHidden(state)
            state = state == true
            if self.hidden == state or self.transitioning then
                return
            end

            self.hidden = state
            self.transitioning = true
            self.restingPosition = self.restingPosition or shell.Position
            local loweredPosition = self.restingPosition + UDim2.fromOffset(0, 18)
            local closeDuration = api.animationsEnabled and 0.22 or 0
            local starDuration = api.animationsEnabled and 0.22 or 0
            local restoreDuration = api.animationsEnabled and 0.12 or 0
            local openDuration = api.animationsEnabled and 0.28 or 0

            if state then
                tween(shell, closeDuration, {
                    GroupTransparency = 1,
                    Position = loweredPosition,
                }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
                tween(shade, closeDuration, {
                    BackgroundTransparency = 1,
                    Position = loweredPosition,
                }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
                task.delay(closeDuration, function()
                    if not gui.Parent or not self.hidden then return end
                    shell.Visible = false
                    shade.Visible = false
                    shell.Position = self.restingPosition
                    shade.Position = self.restingPosition
                    restoreButton.Visible = self.restoreEnabled
                    if self.restoreEnabled then
                        restoreScale.Scale = 0
                        tween(restoreScale, starDuration, {Scale = 1}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                    end
                    self.transitioning = false
                end)
                return
            end

            restoreDragging = false
            tween(restoreScale, restoreDuration, {Scale = 0}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            task.delay(restoreDuration, function()
                if restoreButton.Parent then
                    restoreButton.Visible = false
                end
            end)

            shell.Visible = true
            shade.Visible = true
            shell.Position = loweredPosition
            shade.Position = loweredPosition
            shell.GroupTransparency = 1
            shade.BackgroundTransparency = 1
            scale.Scale = baseScale
            tween(shell, openDuration, {
                GroupTransparency = 0,
                Position = self.restingPosition,
            }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            tween(shade, openDuration, {
                BackgroundTransparency = 1,
                Position = self.restingPosition,
            }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            task.delay(openDuration, function()
                if gui.Parent then
                    self.transitioning = false
                end
            end)
        end
