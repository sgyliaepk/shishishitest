local CONFIG_FOLDER = "MARI_HUB_CONFIGS/"
local CONFIG_AUTOLOAD_FILE = "MARI_HUB_AUTOLOAD.txt"

local keybindRegistry = {}

local function ensureConfigFolder()
    if makefolder then
        pcall(function()
            makefolder(CONFIG_FOLDER)
        end)
    end
end

local function sanitizeConfigName(name)
    return tostring(name or ""):gsub("[^%w %-]", ""):gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
end

local function getConfigPath(name)
    return CONFIG_FOLDER .. name .. ".json"
end

local function listConfigs()
    local names = {}
    if listfiles then
        local success, files = pcall(function()
            return listfiles(CONFIG_FOLDER)
        end)
        if success then
            for _, file in ipairs(files) do
                local fileName = file:gsub("^.*[\\/]", "")
                local name = fileName:gsub("%.json$", "")
                if name ~= "" and fileName ~= name then
                    table.insert(names, name)
                end
            end
        end
    end
    table.sort(names)
    return names
end

local function refreshConfigDropdowns()
    local configs = listConfigs()
    if configDropdown then
        pcall(function()
            configDropdown:Refresh(configs, true)
        end)
    end
    if autoLoadDropdown then
        pcall(function()
            autoLoadDropdown:Refresh(configs, true)
        end)
    end
end

local function collectSettings()
    local settings = {
        autoParryEnabled = autoParryEnabled,
        pingCompensationEnabled = pingCompensationEnabled,
        autoFaceEnabled = autoFaceEnabled,
        healthBarsVisible = healthBarsVisible,
        flingActive = flingActive,
        flingPower = flingPower,
        namesVisible = namesVisible,
        antiFlingEnabled = antiFlingEnabled,
        antiVoidEnabled = antiVoidEnabled,
        flying = flying,
        flySpeed = flySpeed,
        noclipEnabled = noclipEnabled,
        blinkOn = blinkOn,
        blinkDist = blinkDist,
        heartAutoEnabled = _G.__heartAuto == true,
    }
    for name, entry in pairs(keybindRegistry) do
        settings[name] = entry.key
    end
    return settings
end

local function saveConfig(name)
    local cleanName = sanitizeConfigName(name)
    if cleanName == "" then
        createNotification("Config", "Enter a config name first!")
        return false
    end

    ensureConfigFolder()

    local success, encoded = pcall(function()
        return HttpService:JSONEncode(collectSettings())
    end)
    if not success then
        createNotification("Config", "Failed to save config.")
        return false
    end

    local ok = pcall(function()
        writefile(getConfigPath(cleanName), encoded)
    end)
    if ok then
        createNotification("Config", "Saved: " .. cleanName)
        refreshConfigDropdowns()
        return true
    end

    createNotification("Config", "Failed to save config.")
    return false
end

local function deleteConfig(name)
    local cleanName = sanitizeConfigName(name)
    if cleanName == "" then
        createNotification("Config", "Select a config first!")
        return false
    end

    if not delfile or not isfile then
        createNotification("Config", "File IO unavailable!")
        return false
    end

    local path = getConfigPath(cleanName)
    if not isfile(path) then
        createNotification("Config", "Config not found: " .. cleanName)
        refreshConfigDropdowns()
        return false
    end

    local ok = pcall(function()
        delfile(path)
    end)
    if ok then
        createNotification("Config", "Deleted: " .. cleanName)
        refreshConfigDropdowns()
        return true
    end

    createNotification("Config", "Failed to delete config.")
    return false
end

local function setToggleIfChanged(tg, value)
    if tg and tg.CurrentValue ~= value then
        tg:Set(value)
    end
end

local function setKeybindIfChanged(entry, value)
    if entry and entry.keybind and entry.keybind.CurrentKeybind ~= value then
        entry.keybind:Set(value)
    end
end

local function applySettings(settings)
    if type(settings) ~= "table" then
        return
    end

    setToggleIfChanged(autoParryToggle, settings.autoParryEnabled == true)
    setToggleIfChanged(pingCompensationToggle, settings.pingCompensationEnabled == true)
    setToggleIfChanged(autoFaceToggle, settings.autoFaceEnabled == true)
    setToggleIfChanged(healthBarsToggle, settings.healthBarsVisible == true)
    setToggleIfChanged(flingToggleRef, settings.flingActive == true)
    setToggleIfChanged(flingPowerSlider, settings.flingPower or flingPower)
    setToggleIfChanged(showUsernamesToggle, settings.namesVisible == true)
    setToggleIfChanged(antiFlingToggle, settings.antiFlingEnabled == true)
    setToggleIfChanged(antiVoidToggle, settings.antiVoidEnabled == true)
    setToggleIfChanged(flyToggle, settings.flying == true)
    setToggleIfChanged(flySpeedSlider, settings.flySpeed or flySpeed)
    setToggleIfChanged(noclipToggle, settings.noclipEnabled == true)
    setToggleIfChanged(shadowStepToggle, settings.blinkOn == true)
    setToggleIfChanged(shadowStepDistSlider, settings.blinkDist or blinkDist)
    setToggleIfChanged(heartAutoToggle, settings.heartAutoEnabled == true)

    for name, entry in pairs(keybindRegistry) do
        local value = settings[name]
        if type(value) == "string" then
            setKeybindIfChanged(entry, value)
        end
    end
end

local function loadConfig(name)
    local cleanName = sanitizeConfigName(name)
    if cleanName == "" then
        createNotification("Config", "Select a config first!")
        return false
    end

    if not isfile or not readfile then
        createNotification("Config", "File IO unavailable!")
        return false
    end

    local path = getConfigPath(cleanName)
    if not isfile(path) then
        createNotification("Config", "Config not found: " .. cleanName)
        refreshConfigDropdowns()
        return false
    end

    local success, content = pcall(function()
        return readfile(path)
    end)
    if not success then
        createNotification("Config", "Failed to read config.")
        return false
    end

    local ok, settings = pcall(function()
        return HttpService:JSONDecode(content)
    end)
    if not ok or type(settings) ~= "table" then
        createNotification("Config", "Config is corrupted.")
        return false
    end

    pcall(applySettings, settings)
    createNotification("Config", "Loaded config: " .. (cleanName ~= "" and cleanName or "n/a"))
    return true
end

local function getAutoLoadName()
    if not isfile or not readfile then
        return nil
    end
    if not isfile(CONFIG_AUTOLOAD_FILE) then
        return nil
    end

    local success, content = pcall(function()
        return readfile(CONFIG_AUTOLOAD_FILE)
    end)
    if not success then
        return nil
    end

    local name = sanitizeConfigName(content)
    if name == "" then
        return nil
    end

    return name
end

local function saveAutoLoad(name)
    local cleanName = sanitizeConfigName(name)
    if cleanName == "" then
        createNotification("Auto Load", "Select a config first!")
        return false
    end

    local ok = pcall(function()
        writefile(CONFIG_AUTOLOAD_FILE, cleanName)
    end)
    if ok then
        createNotification("Auto Load", "Auto load set to: " .. cleanName)
        return true
    end

    createNotification("Auto Load", "Failed to save auto load.")
    return false
end

local function autoLoadOnStart()
    local autoName = getAutoLoadName()
    if not autoName then
        return
    end

    for _, name in ipairs(listConfigs()) do
        if name == autoName then
            task.delay(2, function()
                loadConfig(autoName)
            end)
            return
        end
    end

    if delfile then
        pcall(function()
            delfile(CONFIG_AUTOLOAD_FILE)
        end)
    end
end

