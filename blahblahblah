-- ===== AUTO PARRY LOGIC =====
local CombatConfig = require(ReplicatedStorage.Shared.Config.CombatConfig)
local attackDelays = {}
local AUTO_FACE_BIND_NAME = "MariHubAutoFace"
local faceCharacter
local faceTarget
local faceUntil = 0
local faceHumanoid
local oldAutoRotate

if typeof(_G.__mariHubAutoFaceCleanup) == "function" then
    pcall(_G.__mariHubAutoFaceCleanup)
end

stopAutoFacing = function()
    RunService:UnbindFromRenderStep(AUTO_FACE_BIND_NAME)
    if faceHumanoid and faceHumanoid.Parent and oldAutoRotate ~= nil then
        faceHumanoid.AutoRotate = oldAutoRotate
    end
    faceCharacter = nil
    faceTarget = nil
    faceHumanoid = nil
    oldAutoRotate = nil
    faceUntil = 0
end
_G.__mariHubAutoFaceCleanup = stopAutoFacing

local function faceAttacker(character, attackerRoot)
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or not attackerRoot then
        return
    end

    local target = Vector3.new(attackerRoot.Position.X, root.Position.Y, attackerRoot.Position.Z)
    if (target - root.Position).Magnitude > 0.01 then
        root.CFrame = CFrame.lookAt(root.Position, target)
    end
end

local function holdAutoFacing(character, attackerRoot, duration)
    if not autoParryEnabled or not autoFaceEnabled then
        return
    end

    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid or not attackerRoot then
        return
    end

    if faceHumanoid ~= humanoid then
        stopAutoFacing()
        faceHumanoid = humanoid
        oldAutoRotate = humanoid.AutoRotate
    end

    faceCharacter = character
    faceTarget = attackerRoot
    faceUntil = math.max(faceUntil, os.clock() + duration)
    humanoid.AutoRotate = false

    RunService:UnbindFromRenderStep(AUTO_FACE_BIND_NAME)
    RunService:BindToRenderStep(AUTO_FACE_BIND_NAME, Enum.RenderPriority.Camera.Value + 2, function()
        if not autoParryEnabled
            or not autoFaceEnabled
            or os.clock() >= faceUntil
            or faceCharacter ~= LocalPlayer.Character
            or not faceTarget
            or not faceTarget.Parent
        then
            stopAutoFacing()
            return
        end
        faceAttacker(faceCharacter, faceTarget)
    end)
end

local animations = ReplicatedStorage:FindFirstChild("Animations")
if animations then
    for _, animation in ipairs(animations:GetDescendants()) do
        if animation:IsA("Animation") then
            local lowerName = animation.Name:lower()
            local combo = tonumber(lowerName:match("^(%d)"))
            local isM1 = combo and lowerName:find("m1", 1, true)
            local isM2 = lowerName:sub(1, 2) == "m2"
            if isM1 or isM2 then
                local style = "default"
                local parent = animation.Parent
                if parent and parent.Name ~= "BaseCombat" then
                    style = parent.Name:lower():gsub("otheranims$", ""):gsub("anims$", "")
                end

                local delay
                if isM1 then
                    delay = CombatConfig.GetScaledStyleM1HitboxDelay(style, combo, 1)
                else
                    delay = CombatConfig.GetStyleM2HitboxDelay(style)
                end

                local id = animation.AnimationId:match("%d+")
                if id and typeof(delay) == "number" then
                    attackDelays[id] = delay
                end
            end
        end
    end
end

local function canAutoParry(character)
    return character
        and character.Parent
        and character:GetAttribute("Equip") == true
        and character:GetAttribute("Ragdoll") ~= true
        and character:GetAttribute("Downed") ~= true
        and character:GetAttribute("GuardBroken") ~= true
        and character:GetAttribute("Greenzone") ~= true
        and character:GetAttribute("RpCombatLocked") ~= true
end

local function stampBlockInput()
    local credits = _G.__GakuranAcCombatInputCreditAt
    if typeof(credits) ~= "table" then
        credits = {}
        _G.__GakuranAcCombatInputCreditAt = credits
    end
    credits["Block.Activated"] = tick()
end

local function applyAutoParry()
    local character = LocalPlayer.Character
    if not autoParryEnabled or not canAutoParry(character) then
        return
    end

    autoParryPulse = autoParryPulse + 1
    local thisPulse = autoParryPulse
    task.spawn(function()
        if not autoParryEnabled
            or character ~= LocalPlayer.Character
            or character:GetAttribute("Equip") ~= true
            or not canAutoParry(character)
        then
            return
        end

        if character:GetAttribute("Blocking") == true then
            Block.Unblock()
            task.wait()
        end

        stampBlockInput()
        Block.Block()

        task.delay(AUTO_PARRY_HOLD, function()
            if autoParryEnabled
                and thisPulse == autoParryPulse
                and character == LocalPlayer.Character
                and character:GetAttribute("Blocking") == true
            then
                Block.Unblock()
            end
        end)
    end)
end

local function onEnemyAnimation(character, track)
    if not autoParryEnabled then
        return
    end

    local animation = track.Animation
    local id = animation and animation.AnimationId:match("%d+")
    local delay = id and attackDelays[id]
    if not delay then
        return
    end

    local myCharacter = LocalPlayer.Character
    local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
    local enemyRoot = character:FindFirstChild("HumanoidRootPart")
    if not myRoot or not enemyRoot or (myRoot.Position - enemyRoot.Position).Magnitude > AUTO_PARRY_RANGE then
        return
    end

    if myCharacter:GetAttribute("Equip") ~= true then
        return
    end

    local speed = math.max(math.abs(track.Speed), 0.05)
    local parryDelay = math.max(0, delay / speed - getAutoParryLead())
    holdAutoFacing(myCharacter, enemyRoot, parryDelay + AUTO_PARRY_HOLD + 0.08)
    task.delay(parryDelay, function()
        if not autoParryEnabled then
            return
        end

        myCharacter = LocalPlayer.Character
        myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        enemyRoot = character:FindFirstChild("HumanoidRootPart")
        if myRoot and enemyRoot and (myRoot.Position - enemyRoot.Position).Magnitude <= AUTO_PARRY_RANGE then
            holdAutoFacing(myCharacter, enemyRoot, AUTO_PARRY_HOLD + 0.08)
            applyAutoParry()
        end
    end)
end

local function wireAutoParryCharacter(player, character)
    if player == LocalPlayer then
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
    local animator = humanoid and (humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator", 5))
    if animator then
        table.insert(connections, animator.AnimationPlayed:Connect(function(track)
            onEnemyAnimation(character, track)
        end))
    end
end

local function wireAutoParryPlayer(player)
    if player.Character then
        task.spawn(wireAutoParryCharacter, player, player.Character)
    end
    table.insert(connections, player.CharacterAdded:Connect(function(character)
        wireAutoParryCharacter(player, character)
    end))
end

for _, player in ipairs(Players:GetPlayers()) do
    wireAutoParryPlayer(player)
end
table.insert(connections, Players.PlayerAdded:Connect(wireAutoParryPlayer))

