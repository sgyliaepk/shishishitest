function UI.autoPiano.isAtPiano()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    return character ~= nil
        and character:GetAttribute("PlayingInstrument") == "Piano"
        and humanoid ~= nil
        and humanoid.Sit
end

function UI.autoPiano.getInput(noteIndex)
    local character = UI.autoPiano.keyLayout:sub(noteIndex, noteIndex)
    if character == "" then return nil end

    if character:match("%a") then
        return Enum.KeyCode[character:upper()], character == character:upper()
    end
    local keyName = UI.autoPiano.digitKeys[character]
    if keyName then
        return Enum.KeyCode[keyName], false
    end
    keyName = UI.autoPiano.symbolKeys[character]
    if keyName then
        return Enum.KeyCode[keyName], true
    end
    return nil
end

function UI.autoPiano.pressNote(noteIndex, token)
    local keyCode, needsShift = UI.autoPiano.getInput(noteIndex)
    if not keyCode or token ~= UI.autoPiano.token then return end

    if needsShift then
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
    end
    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
    task.wait(0.025)
    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    if needsShift then
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
    end
end

function UI.autoPiano.stop()
    UI.autoPiano.token = UI.autoPiano.token + 1
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
end

function UI.autoPiano.toggle(state)
    UI.autoPiano.enabled = state == true
    if not UI.autoPiano.enabled then
        UI.autoPiano.stop()
    end
end

function UI.autoPiano.playSelected()
    if not UI.autoPiano.enabled then
        createNotification("Auto Play Piano", "Enable Auto Play Piano first.")
        return
    end
    if not UI.autoPiano.isAtPiano() then
        createNotification("Auto Play Piano", "Sit at and activate a piano first.")
        return
    end

    local song = UI.autoPiano.songs[UI.autoPiano.selectedSong]
    if not song then
        createNotification("Auto Play Piano", "Select a valid song.")
        return
    end

    UI.autoPiano.stop()
    local token = UI.autoPiano.token
    task.spawn(function()
        if song.sheet then
            local position = 1
            while position <= #song.sheet do
                if token ~= UI.autoPiano.token or not UI.autoPiano.enabled then return end
                if not UI.autoPiano.isAtPiano() then
                    UI.autoPiano.stop()
                    createNotification("Auto Play Piano", "Playback stopped because you left the piano.")
                    return
                end

                local character = song.sheet:sub(position, position)
                if character == "|" then
                    task.wait(song.barRest)
                elseif character == "[" then
                    local closePosition = song.sheet:find("]", position + 1, true)
                    if closePosition then
                        for chordPosition = position + 1, closePosition - 1 do
                            local noteIndex = UI.autoPiano.keyLayout:find(song.sheet:sub(chordPosition, chordPosition), 1, true)
                            if noteIndex then
                                UI.autoPiano.pressNote(noteIndex, token)
                            end
                        end
                        task.wait(song.step)
                        position = closePosition
                    end
                elseif character ~= " " then
                    local noteIndex = UI.autoPiano.keyLayout:find(character, 1, true)
                    if noteIndex then
                        UI.autoPiano.pressNote(noteIndex, token)
                        task.wait(song.step)
                    end
                end
                position = position + 1
            end
        else
            for event in song.sequence:gmatch("%S+") do
                if token ~= UI.autoPiano.token or not UI.autoPiano.enabled then return end
                if not UI.autoPiano.isAtPiano() then
                    UI.autoPiano.stop()
                    createNotification("Auto Play Piano", "Playback stopped because you left the piano.")
                    return
                end

                local noteText, beatText = event:match("^([^:]+):?(.*)$")
                local beats = tonumber(beatText) or 1
                local startedAt = os.clock()
                for note in noteText:gmatch("[^+]+") do
                    UI.autoPiano.pressNote(tonumber(note), token)
                end
                local remaining = 60 / song.tempo * beats - (os.clock() - startedAt)
                if remaining > 0 then
                    task.wait(remaining)
                end
            end
        end
        if token == UI.autoPiano.token and UI.autoPiano.enabled then
            createNotification("Auto Play Piano", "Finished: " .. UI.autoPiano.selectedSong)
        end
    end)
end

-- ===== RHYTHM AUTO PERFECT =====
if typeof(_G.__mariHubRhythmAutoPerfectCleanup) == "function" then
    pcall(_G.__mariHubRhythmAutoPerfectCleanup)
end

function rhythmAutoPerfect.releaseSession(session)
    if not session or typeof(session._handleLaneRelease) ~= "function" then
        table.clear(rhythmAutoPerfect.heldNotes)
        table.clear(rhythmAutoPerfect.heldLanes)
        table.clear(rhythmAutoPerfect.tapReleaseAt)
        return
    end

    for lane = 1, session._lanes or 0 do
        if session._laneTouchActive then
            session._laneTouchActive[lane] = false
        end
        if session._laneKeyDown and session._laneKeyDown[lane] then
            pcall(session._handleLaneRelease, session, lane)
        end
    end
    table.clear(rhythmAutoPerfect.heldNotes)
    table.clear(rhythmAutoPerfect.heldLanes)
    table.clear(rhythmAutoPerfect.tapReleaseAt)
end

function rhythmAutoPerfect.fireLanePressed(session, lane, hitTime, claimed)
    if not session._onLanePressedCallbacks then
        return
    end

    for _, callback in pairs(session._onLanePressedCallbacks) do
        if callback then
            pcall(callback, lane, hitTime, claimed)
        end
    end
end

function rhythmAutoPerfect.beginHold(session, note)
    rhythmAutoPerfect.tapReleaseAt[note.lane] = nil
    if session._laneTouchActive then
        session._laneTouchActive[note.lane] = true
    end
    if session._laneKeyDown then
        session._laneKeyDown[note.lane] = true
    end
    if typeof(session._syncReceptorVisual) == "function" then
        pcall(session._syncReceptorVisual, session, note.lane)
    end
    rhythmAutoPerfect.heldNotes[note] = true
    rhythmAutoPerfect.heldLanes[note.lane] = note
end

function rhythmAutoPerfect.endHold(session, note)
    if session._laneTouchActive then
        session._laneTouchActive[note.lane] = false
    end
    if session._laneKeyDown then
        session._laneKeyDown[note.lane] = false
    end

    if not note.resolved and note.holding then
        pcall(session._onReleaseLane, session, note.lane, note.t + note.len)
    end
    if typeof(session._syncReceptorVisual) == "function" then
        pcall(session._syncReceptorVisual, session, note.lane)
    end
    rhythmAutoPerfect.heldNotes[note] = nil
    if rhythmAutoPerfect.heldLanes[note.lane] == note then
        rhythmAutoPerfect.heldLanes[note.lane] = nil
    end
end

function rhythmAutoPerfect.pressTap(session, note, now)
    if rhythmAutoPerfect.tapReleaseAt[note.lane]
        and not rhythmAutoPerfect.heldLanes[note.lane]
    then
        if session._laneTouchActive then
            session._laneTouchActive[note.lane] = false
        end
        if session._laneKeyDown then
            session._laneKeyDown[note.lane] = false
        end
        if typeof(session._syncReceptorVisual) == "function" then
            pcall(session._syncReceptorVisual, session, note.lane)
        end
    end

    if session._laneTouchActive then
        session._laneTouchActive[note.lane] = true
    end
    if session._laneKeyDown then
        session._laneKeyDown[note.lane] = true
    end
    if typeof(session._syncReceptorVisual) == "function" then
        pcall(session._syncReceptorVisual, session, note.lane)
    end
    rhythmAutoPerfect.tapReleaseAt[note.lane] = now + 0.045
end

function rhythmAutoPerfect.releaseFinishedTaps(session, now)
    for lane, releaseAt in pairs(rhythmAutoPerfect.tapReleaseAt) do
        if now >= releaseAt then
            if not rhythmAutoPerfect.heldLanes[lane] then
                if session._laneTouchActive then
                    session._laneTouchActive[lane] = false
                end
                if session._laneKeyDown then
                    session._laneKeyDown[lane] = false
                end
                if typeof(session._syncReceptorVisual) == "function" then
                    pcall(session._syncReceptorVisual, session, lane)
                end
            end
            rhythmAutoPerfect.tapReleaseAt[lane] = nil
        end
    end
end

function rhythmAutoPerfect.findSession()
    if rhythmAutoPerfect.service then
        local session = rawget(rhythmAutoPerfect.service, "_session")
        if session and not rawget(session, "_destroyed") then
            return session
        end
        return nil
    end

    local getGc = getgc
    if typeof(getGc) ~= "function" then
        return nil
    end

    if os.clock() < rhythmAutoPerfect.nextScanAt then
        return nil
    end
    rhythmAutoPerfect.nextScanAt = os.clock() + 0.5

    local success, objects = pcall(getGc, true)
    if not success then
        return nil
    end

    for _, object in ipairs(objects) do
        if type(object) == "table" then
            local session = rawget(object, "_session")
            if type(session) == "table"
                and type(rawget(session, "_liveNotes")) == "table"
                and typeof(session._onPressLane) == "function"
                and typeof(session._onReleaseLane) == "function"
                and not rawget(session, "_destroyed")
            then
                rhythmAutoPerfect.service = object
                return session
            end
        end
    end

    rhythmAutoPerfect.service = nil
    return nil
end

function rhythmAutoPerfect.step()
    local session = rhythmAutoPerfect.findSession()
    if session ~= rhythmAutoPerfect.session then
        rhythmAutoPerfect.releaseSession(rhythmAutoPerfect.session)
        rhythmAutoPerfect.session = session
    end
    if not session or not session._started or session._destroyed then
        return
    end

    local success, now = pcall(session._now, session)
    if not success or typeof(now) ~= "number" then
        return
    end

    rhythmAutoPerfect.releaseFinishedTaps(session, now)

    for _, note in ipairs(session._liveNotes) do
        if rhythmAutoPerfect.heldNotes[note]
            and (note.resolved or now >= note.t + note.len - 0.02)
        then
            rhythmAutoPerfect.endHold(session, note)
        end

        if not note.resolved and not note.hit and now >= note.t then
            -- Pass the chart timestamp so the engine judges zero timing error.
            local pressed, claimed = pcall(session._onPressLane, session, note.lane, note.t)
            if pressed and claimed then
                rhythmAutoPerfect.fireLanePressed(session, note.lane, note.t, true)

                if note.len > 0 and note.holding then
                    rhythmAutoPerfect.beginHold(session, note)
                elseif note.len <= 0 then
                    rhythmAutoPerfect.pressTap(session, note, now)
                end
            end
        end

        if not note.resolved then
            if note.len > 0
                and note.hit
                and note.holding
                and not rhythmAutoPerfect.heldNotes[note]
                and now >= note.t + note.len
            then
                pcall(session._onReleaseLane, session, note.lane, note.t + note.len)
            end
        end
    end

end

function rhythmAutoPerfect.toggle(state, silent)
    rhythmAutoPerfect.enabled = state

    if rhythmAutoPerfect.connection then
        rhythmAutoPerfect.connection:Disconnect()
        rhythmAutoPerfect.connection = nil
    end

    if not state then
        rhythmAutoPerfect.releaseSession(rhythmAutoPerfect.session)
        rhythmAutoPerfect.session = nil
        rhythmAutoPerfect.service = nil
        rhythmAutoPerfect.nextScanAt = 0
        return
    end

    if typeof(getgc) ~= "function" then
        rhythmAutoPerfect.enabled = false
        if not silent then
            createNotification("Auto Perfect", "This executor does not support getgc.")
        end
        task.defer(function()
            if UI.rhythmAutoPerfectToggle then
                UI.rhythmAutoPerfectToggle:Set(false)
            end
        end)
        return
    end

    rhythmAutoPerfect.connection = RunService.RenderStepped:Connect(rhythmAutoPerfect.step)
end

_G.__mariHubRhythmAutoPerfectCleanup = function()
    rhythmAutoPerfect.toggle(false, true)
end

-- ===== RETURN BY DEATH =====
function returnByDeath.wireCharacter(character)
    for _, connection in ipairs(returnByDeath.deathConnections) do
        connection:Disconnect()
    end
    table.clear(returnByDeath.deathConnections)

    if not returnByDeath.enabled then
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
    if not humanoid then
        return
    end

    local function captureDeathPosition()
        local root = character:FindFirstChild("HumanoidRootPart")
        if returnByDeath.enabled and root then
            local position = root.Position
            local voidLimit = originalFallenPartsDestroyHeight
            if voidLimit ~= voidLimit then
                voidLimit = -500
            end

            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {character}
            local hasGroundBelow = workspace:Raycast(
                position,
                Vector3.new(0, -250, 0),
                rayParams
            ) ~= nil

            local belowDestroyBoundary = position.Y <= voidLimit + 50
            local strandedBelowMap = position.Y <= voidLimit + 200 and not hasGroundBelow
            if belowDestroyBoundary or strandedBelowMap then
                returnByDeath.deathPosition = nil
                return
            end

            returnByDeath.deathPosition = position
        end
    end

    table.insert(returnByDeath.deathConnections, humanoid.Died:Connect(captureDeathPosition))
    table.insert(returnByDeath.deathConnections, character:GetAttributeChangedSignal("Dead"):Connect(function()
        if character:GetAttribute("Dead") == true then
            captureDeathPosition()
        end
    end))

    if character:GetAttribute("Dead") == true then
        captureDeathPosition()
    end
end

function returnByDeath.teleportCharacter(character)
    local deathPosition = returnByDeath.deathPosition
    if not returnByDeath.enabled or not deathPosition then
        return
    end

    returnByDeath.teleportToken = returnByDeath.teleportToken + 1
    local token = returnByDeath.teleportToken

    task.spawn(function()
        local root = character:WaitForChild("HumanoidRootPart", 10)
        local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
        if not root or not humanoid or not returnByDeath.enabled or token ~= returnByDeath.teleportToken then
            return
        end

        local startedAt = os.clock()
        local wasSeated = false
        while true do
            if not returnByDeath.enabled
                or token ~= returnByDeath.teleportToken
                or character ~= LocalPlayer.Character
                or not root.Parent
            then
                return
            end

            local seated = humanoid.Sit or humanoid.SeatPart ~= nil
            wasSeated = wasSeated or seated
            character:PivotTo(CFrame.new(deathPosition + Vector3.new(0, 3, 0)) * character:GetPivot().Rotation)

            -- Keep the destination through the chair state, then release on Space.
            if wasSeated and not seated then
                break
            end
            if not wasSeated and os.clock() - startedAt >= 1 then
                break
            end

            RunService.Heartbeat:Wait()
        end

        returnByDeath.deathPosition = nil
    end)
end

function returnByDeath.toggle(state)
    returnByDeath.enabled = state
    returnByDeath.teleportToken = returnByDeath.teleportToken + 1

    if not state then
        returnByDeath.deathPosition = nil
        for _, connection in ipairs(returnByDeath.deathConnections) do
            connection:Disconnect()
        end
        table.clear(returnByDeath.deathConnections)
        return
    end

    local character = LocalPlayer.Character
    if character then
        task.spawn(returnByDeath.wireCharacter, character)
    end
end

table.insert(connections, LocalPlayer.CharacterAdded:Connect(function(character)
    local shouldReturn = returnByDeath.enabled and returnByDeath.deathPosition ~= nil
    task.spawn(returnByDeath.wireCharacter, character)
    if shouldReturn then
        returnByDeath.teleportCharacter(character)
    end
end))

