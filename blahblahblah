-- ===== FLING LOGIC =====
local flingPartsByChar = {}
local flingCharConnections = {}
local flingCollisionState = {}

local function onFlingPartAdded(char, desc)
    if desc:IsA("BasePart") then
        local list = flingPartsByChar[char]
        if list then
            table.insert(list, desc)
        end
    end
end

local function wireFlingCharacter(char)
    if flingPartsByChar[char] then
        return
    end

    local list = {}
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            table.insert(list, part)
        end
    end
    flingPartsByChar[char] = list

    table.insert(flingCharConnections, char.DescendantAdded:Connect(function(desc)
        onFlingPartAdded(char, desc)
    end))
    table.insert(flingCharConnections, char.DescendantRemoving:Connect(function(desc)
        local l = flingPartsByChar[char]
        if l and desc:IsA("BasePart") then
            for i = #l, 1, -1 do
                if l[i] == desc then
                    table.remove(l, i)
                end
            end
        end
    end))
end

local function clearFlingWiring()
    for _, conn in ipairs(flingCharConnections) do
        pcall(function()
            conn:Disconnect()
        end)
    end
    table.clear(flingCharConnections)
    table.clear(flingPartsByChar)
end

local function setPartGhosted(part)
    if flingCollisionState[part] == nil then
        flingCollisionState[part] = part.CanCollide
    end
    part.CanCollide = false
end

local function restoreGhostedParts()
    for part, state in pairs(flingCollisionState) do
        if part and part.Parent then
            part.CanCollide = state
        end
    end
    table.clear(flingCollisionState)
end

local function zeroCharacterVelocity(char)
    if not char then
        return
    end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Velocity = Vector3.zero
            pcall(function()
                part.AssemblyLinearVelocity = Vector3.zero
            end)
        end
    end
end

local function stopFlingLoop()
    flingActive = false
    flingPulse = flingPulse + 1
    if flingConnection then
        flingConnection:Disconnect()
        flingConnection = nil
    end
    clearFlingWiring()
end

local function stopFlingOnDeath()
    if not flingActive then
        return
    end

    stopFlingLoop()
    pcall(restoreGhostedParts)
    pcall(zeroCharacterVelocity, LocalPlayer.Character)
end

local startFlingMonitor

local function startFlingLoop()
    if not flingActive or flingConnection then
        return
    end
    flingConnection = RunService.PostSimulation:Connect(function()
        if not flingActive then return end
        local pulse = flingPulse
        if not LocalPlayer.Character then return end
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local victims = {}
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                table.insert(victims, p.Character)
            end
        end

        for _, char in ipairs(victims) do
            wireFlingCharacter(char)
        end

        for _, char in ipairs(victims) do
            local parts = flingPartsByChar[char]
            if parts then
                for _, part in ipairs(parts) do
                    if part and part.Parent and part.CanCollide then
                        setPartGhosted(part)
                    end
                end
            end
        end

        local shouldFling = false
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
                if tHrp then
                    local dist = (hrp.Position - tHrp.Position).Magnitude
                    if dist <= 20 then
                        shouldFling = true
                        break
                    end
                end
            end
        end

        if shouldFling then
            local playerGhosted = {}
            for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
                if v:IsA("BasePart") and v.CanCollide then
                    setPartGhosted(v)
                    table.insert(playerGhosted, v)
                end
            end
            local strength = TRAMPOLINE_POWER * 100
            local oldV = hrp.Velocity
            local newV = Vector3.new(strength, strength, strength)
            pcall(function()
                hrp.Velocity = newV
                hrp.AssemblyLinearVelocity = newV
            end)
            pcall(function()
                RunService.RenderStepped:Wait()
            end)
            if flingActive and pulse == flingPulse then
                pcall(function()
                    hrp.Velocity = oldV
                    hrp.AssemblyLinearVelocity = oldV
                end)
            else
                pcall(function()
                    hrp.Velocity = Vector3.zero
                    hrp.AssemblyLinearVelocity = Vector3.zero
                end)
            end
            for _, part in ipairs(playerGhosted) do
                if part and part.Parent then
                    part.CanCollide = true
                end
                flingCollisionState[part] = nil
            end
        end
    end)
    startFlingMonitor()
end

