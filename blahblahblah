        UI.clickSpectate.createButton()
    end
    if UI.clickSpectate.button then
        UI.clickSpectate.button.Visible = state == true
    end
end

function UI.clickSpectate.destroyButton()
    if UI.clickSpectate.buttonConnection then
        UI.clickSpectate.buttonConnection:Disconnect()
        UI.clickSpectate.buttonConnection = nil
    end
    if UI.clickSpectate.button then
        UI.clickSpectate.button:Destroy()
        UI.clickSpectate.button = nil
    end
end

function UI.clickSpectate.toggle(state)
    UI.clickSpectate.enabled = state == true
    if UI.clickSpectate.connection then
        UI.clickSpectate.connection:Disconnect()
        UI.clickSpectate.connection = nil
    end
    if not UI.clickSpectate.enabled then
        return
    end

    UI.clickSpectate.connection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed
            or input.UserInputType ~= Enum.UserInputType.MouseButton1
            or UserInputService:GetFocusedTextBox()
        then
            return
        end

        if UI.clickSpectate.button and UI.clickSpectate.button.Visible then
            local position = input.Position
            local buttonPosition = UI.clickSpectate.button.AbsolutePosition
            local buttonSize = UI.clickSpectate.button.AbsoluteSize
            if position.X >= buttonPosition.X
                and position.X <= buttonPosition.X + buttonSize.X
                and position.Y >= buttonPosition.Y
                and position.Y <= buttonPosition.Y + buttonSize.Y
            then
                return
            end
        end

        local camera = workspace.CurrentCamera
        if not camera then
            return
        end

        local targetCharacters = {}
        for _, otherPlayer in ipairs(Players:GetPlayers()) do
            if otherPlayer ~= LocalPlayer and otherPlayer.Character then
                table.insert(targetCharacters, otherPlayer.Character)
            end
        end
        if #targetCharacters == 0 then
            return
        end

        -- Only character geometry participates, so map walls cannot block this ray.
        local ray = camera:ScreenPointToRay(input.Position.X, input.Position.Y)
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Include
        raycastParams.FilterDescendantsInstances = targetCharacters
        raycastParams.IgnoreWater = true

        local result = workspace:Raycast(ray.Origin, ray.Direction * 100000, raycastParams)
        local instance = result and result.Instance
        local player
        while instance and instance ~= workspace do
            if instance:IsA("Model") then
                player = Players:GetPlayerFromCharacter(instance)
                if player then
                    break
                end
            end
            instance = instance.Parent
        end

        if player and player ~= LocalPlayer then
            startSpectating(player.Name)
        end
    end)
end

