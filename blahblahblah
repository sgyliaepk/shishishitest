            local starPosition = restoreButton.Position
            return {
                hub = {
                    xScale = hubPosition.X.Scale,
                    xOffset = hubPosition.X.Offset,
                    yScale = hubPosition.Y.Scale,
                    yOffset = hubPosition.Y.Offset,
                },
                star = {
                    xScale = starPosition.X.Scale,
                    xOffset = starPosition.X.Offset,
                    yScale = starPosition.Y.Scale,
                    yOffset = starPosition.Y.Offset,
                },
            }
        end

        function window:SetSavedPositions(positions)
            if type(positions) ~= "table" then return end

            local function readPosition(value)
                if type(value) ~= "table" then return nil end
                local xScale = tonumber(value.xScale)
                local xOffset = tonumber(value.xOffset)
                local yScale = tonumber(value.yScale)
                local yOffset = tonumber(value.yOffset)
                if not xScale or not xOffset or not yScale or not yOffset then
                    return nil
                end
                return UDim2.new(xScale, xOffset, yScale, yOffset)
            end

            local hubPosition = readPosition(positions.hub)
            local starPosition = readPosition(positions.star)
            if hubPosition then
                self.restingPosition = hubPosition
                shell.Position = hubPosition
                shade.Position = hubPosition
            end
            if starPosition then
                restoreButton.Position = starPosition
            end
        end

