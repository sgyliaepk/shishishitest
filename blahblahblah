    local head = character and (character:FindFirstChild("Head") or character:WaitForChild("Head", 5))
    if not head or not UI.hpM2Cooldown.enabled then
        return
    end

    local gui = Instance.new("BillboardGui")
    gui.Name = "MariHpM2Cooldown"
    gui.Adornee = head
    gui.Size = UDim2.fromOffset(210, 48)
    gui.StudsOffset = Vector3.new(0, 2.3, 0)
    gui.AlwaysOnTop = true
    gui.MaxDistance = 250
    gui.Parent = head

    local hpLabel = Instance.new("TextLabel")
    hpLabel.Name = "HP"
    hpLabel.Size = UDim2.new(1, 0, 0.5, 0)
    hpLabel.BackgroundTransparency = 1
    hpLabel.Font = Enum.Font.GothamBold
    hpLabel.TextColor3 = Color3.fromRGB(80, 235, 125)
    hpLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    hpLabel.TextStrokeTransparency = 0
    hpLabel.TextSize = 15
    hpLabel.Parent = gui

    local cooldownLabel = Instance.new("TextLabel")
    cooldownLabel.Name = "M2Cooldown"
    cooldownLabel.Position = UDim2.fromScale(0, 0.5)
    cooldownLabel.Size = UDim2.new(1, 0, 0.5, 0)
    cooldownLabel.BackgroundTransparency = 1
    cooldownLabel.Font = Enum.Font.GothamBold
    cooldownLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    cooldownLabel.TextStrokeTransparency = 0
    cooldownLabel.TextSize = 14
    cooldownLabel.Parent = gui

    UI.hpM2Cooldown.gui = gui
end

function UI.hpM2Cooldown.update()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local head = character and character:FindFirstChild("Head")
    if not character or not humanoid or not head then
        UI.hpM2Cooldown.destroyGui()
        return
    end

    if not UI.hpM2Cooldown.gui or UI.hpM2Cooldown.gui.Adornee ~= head then
        UI.hpM2Cooldown.createGui(character)
    end
    if not UI.hpM2Cooldown.gui then
        return
    end

    local hpLabel = UI.hpM2Cooldown.gui:FindFirstChild("HP")
    local cooldownLabel = UI.hpM2Cooldown.gui:FindFirstChild("M2Cooldown")
    if not hpLabel or not cooldownLabel then
        return
    end

    local healthRatio = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
    hpLabel.Text = string.format("HP: %d / %d", math.ceil(humanoid.Health), math.ceil(humanoid.MaxHealth))
    hpLabel.TextColor3 = Color3.fromHSV(healthRatio * 0.32, 0.75, 0.95)

    local coolingDown = character:GetAttribute("M2Cooldown") == true
    local remaining = UI.hpM2Cooldown.getExactRemaining()
    if coolingDown and not UI.hpM2Cooldown.wasCoolingDown then
        UI.hpM2Cooldown.fallbackStartedAt = time()
    elseif not coolingDown then
        UI.hpM2Cooldown.fallbackStartedAt = nil
    end
    UI.hpM2Cooldown.wasCoolingDown = coolingDown

    if remaining == nil and coolingDown then
        UI.hpM2Cooldown.fallbackStartedAt = UI.hpM2Cooldown.fallbackStartedAt or time()
        remaining = math.max(
            0,
            UI.hpM2Cooldown.getDuration(character) - (time() - UI.hpM2Cooldown.fallbackStartedAt)
        )
    end

    if remaining and remaining > 0 then
        cooldownLabel.Text = string.format("M2: %.1fs", remaining)
        cooldownLabel.TextColor3 = Color3.fromRGB(255, 105, 105)
    else
        cooldownLabel.Text = "M2: READY"
        cooldownLabel.TextColor3 = Color3.fromRGB(90, 235, 135)
    end
    UI.hpM2Cooldown.gui.Enabled = humanoid.Health > 0
end

function UI.hpM2Cooldown.toggle(state)
    UI.hpM2Cooldown.enabled = state
    if UI.hpM2Cooldown.connection then
        UI.hpM2Cooldown.connection:Disconnect()
        UI.hpM2Cooldown.connection = nil
    end

    UI.hpM2Cooldown.fallbackStartedAt = nil
    UI.hpM2Cooldown.wasCoolingDown = false
    if not state then
        UI.hpM2Cooldown.destroyGui()
        return
    end

    UI.hpM2Cooldown.update()
    UI.hpM2Cooldown.connection = RunService.Heartbeat:Connect(UI.hpM2Cooldown.update)
end

