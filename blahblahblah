local function saveConfig(name)
    local cleanName = sanitizeConfigName(name)
    if cleanName == "" then
        createNotification("Config", "Enter a config name first!")
        return false
    end

    ensureConfigFolder()

    local success, encoded = pcall(function()
        return HttpService:JSONEncode(collectSettings())
    end)
    if not success then
        createNotification("Config", "Failed to save config.")
        return false
    end

    local ok = pcall(function()
        writefile(getConfigPath(cleanName), encoded)
    end)
    if ok then
        createNotification("Config", "Saved: " .. cleanName)
        refreshConfigDropdowns()
        return true
    end

    createNotification("Config", "Failed to save config.")
    return false
end

local function deleteConfig(name)
    local cleanName = sanitizeConfigName(name)
    if cleanName == "" then
        createNotification("Config", "Select a config first!")
        return false
    end

    if not delfile or not isfile then
        createNotification("Config", "File IO unavailable!")
        return false
    end

    local path = getConfigPath(cleanName)
    if not isfile(path) then
        createNotification("Config", "Config not found: " .. cleanName)
        refreshConfigDropdowns()
        return false
    end

    local ok = pcall(function()
        delfile(path)
    end)
    if ok then
        createNotification("Config", "Deleted: " .. cleanName)
        refreshConfigDropdowns()
        return true
    end

    createNotification("Config", "Failed to delete config.")
    return false
end

local function setToggleIfChanged(tg, value)
    if tg and tg.CurrentValue ~= value then
        tg:Set(value)
    end
end

local function setKeybindIfChanged(entry, value)
    if entry and entry.keybind and entry.keybind.CurrentKeybind ~= value then
        entry.keybind:Set(value)
    end
end

local function applySettings(settings)
    if type(settings) ~= "table" then
        return
    end

    setToggleIfChanged(UI.autoParryToggle, settings.autoParryEnabled == true)
    setToggleIfChanged(UI.pingCompensationToggle, settings.pingCompensationEnabled == true)
    setToggleIfChanged(UI.autoFaceToggle, settings.autoFaceEnabled == true)
    setToggleIfChanged(UI.infStaminaToggle, settings.infStaminaEnabled == true)
    setToggleIfChanged(UI.noDodgeCooldownToggle, settings.noDodgeCooldownEnabled == true)
    setToggleIfChanged(UI.antiStunToggle, settings.antiStunEnabled == true)
    setToggleIfChanged(UI.noBlurToggle, settings.noBlurEnabled == true)
    setToggleIfChanged(UI.chatLoggerToggle, settings.chatLoggerEnabled == true)
    setToggleIfChanged(UI.autoChessToggle, settings.autoChessEnabled == true)
    setToggleIfChanged(UI.espToggle, settings.espEnabled == true)
    setToggleIfChanged(UI.espDistanceSlider, settings.espDistance or espDistance)
    setToggleIfChanged(UI.hpM2CooldownToggle, settings.hpM2CooldownEnabled == true)
    setToggleIfChanged(UI.infCamZoomToggle, settings.infCamZoomEnabled == true)
    setToggleIfChanged(UI.jetpackToggle, settings.jetpackEnabled == true)
    setToggleIfChanged(UI.flingVoidToggle, settings.flingVoidEnabled == true)
    setToggleIfChanged(UI.clickSpectateToggle, settings.clickSpectateEnabled == true)
    setToggleIfChanged(UI.autoGreenToggle, settings.autoGreenEnabled == true)
    setToggleIfChanged(UI.autoPianoToggle, settings.autoPianoEnabled == true)
    if type(settings.pianoSong) == "string" and UI.autoPiano.songs[settings.pianoSong] then
        UI.autoPiano.selectedSong = settings.pianoSong
        if UI.pianoSongDropdown and UI.pianoSongDropdown.CurrentOption ~= settings.pianoSong then
            UI.pianoSongDropdown:Set(settings.pianoSong)
        end
    end
    setToggleIfChanged(UI.returnByDeathToggle, settings.returnByDeathEnabled == true)
    setToggleIfChanged(UI.rhythmAutoPerfectToggle, settings.rhythmAutoPerfectEnabled == true)
    setToggleIfChanged(UI.healthBarsToggle, settings.healthBarsVisible == true)
    setToggleIfChanged(UI.trampolineToggleRef, settings.trampolineActive == true)
    setToggleIfChanged(UI.showUsernamesToggle, settings.namesVisible == true)
    setToggleIfChanged(UI.antiFlingToggle, settings.antiFlingEnabled == true)
    setToggleIfChanged(UI.antiVoidToggle, settings.antiVoidEnabled == true)
    setToggleIfChanged(UI.flyToggle, settings.flying == true)
    setToggleIfChanged(UI.flySpeedSlider, settings.flySpeed or flySpeed)
    setToggleIfChanged(UI.walkSpeedSlider, settings.walkSpeedValue or UI.walkSpeed.value)
    setToggleIfChanged(UI.walkSpeedToggle, settings.walkSpeedEnabled == true)
    setToggleIfChanged(UI.noclipToggle, settings.noclipEnabled == true)
    setToggleIfChanged(UI.shadowStepToggle, settings.blinkOn == true)
    setToggleIfChanged(UI.shadowStepDistSlider, settings.blinkDist or blinkDist)
    setToggleIfChanged(UI.heartAutoToggle, settings.heartAutoEnabled == true)

    if type(settings.uiColorPreset) == "string" and UI.colorPresets[settings.uiColorPreset] then
        UI.colorPreset = settings.uiColorPreset
        if UI.uiColorDropdown.CurrentOption ~= settings.uiColorPreset then
            UI.uiColorDropdown:Set(settings.uiColorPreset)
        end
        Window:SetAccent(UI.colorPresets[settings.uiColorPreset])
    end
    if type(settings.uiToggleKeybind) == "string" then
        UI.toggleKeybind = settings.uiToggleKeybind
        if UI.uiToggleKeybind.CurrentKeybind ~= settings.uiToggleKeybind then
            UI.uiToggleKeybind:Set(settings.uiToggleKeybind)
        end
        Window:SetToggleKeybind(settings.uiToggleKeybind)
    end
    if settings.uiRestoreButtonEnabled ~= nil then
        UI.restoreButtonEnabled = settings.uiRestoreButtonEnabled == true
        setToggleIfChanged(UI.restoreButtonToggle, UI.restoreButtonEnabled)
        Window:SetRestoreEnabled(UI.restoreButtonEnabled)
    end
    if settings.uiAnimationsEnabled ~= nil then
        UI.animationsEnabled = settings.uiAnimationsEnabled == true
        setToggleIfChanged(UI.animationsToggle, UI.animationsEnabled)
        Window:SetAnimationsEnabled(UI.animationsEnabled)
    end
    if type(settings.uiScalePercent) == "number" then
        UI.scalePercent = settings.uiScalePercent
        setToggleIfChanged(UI.uiScaleSlider, settings.uiScalePercent)
        Window:SetUIScale(settings.uiScalePercent)
    end
    if type(settings.uiHubPosition) == "table" or type(settings.uiStarPosition) == "table" then
        Window:SetSavedPositions({
            hub = settings.uiHubPosition,
            star = settings.uiStarPosition,
        })
    end

    for name, entry in pairs(keybindRegistry) do
        local value = settings[name]
        if type(value) == "string" then
            setKeybindIfChanged(entry, value)
        end
    end
end

local function loadConfig(name)
    if UI.unloaded then
        return false
    end

    local cleanName = sanitizeConfigName(name)
    if cleanName == "" then
        createNotification("Config", "Select a config first!")
        return false
    end

    if not isfile or not readfile then
        createNotification("Config", "File IO unavailable!")
        return false
    end

    local path = getConfigPath(cleanName)
    if not isfile(path) then
        createNotification("Config", "Config not found: " .. cleanName)
        refreshConfigDropdowns()
        return false
    end

    local success, content = pcall(function()
        return readfile(path)
    end)
    if not success then
        createNotification("Config", "Failed to read config.")
        return false
    end

    local ok, settings = pcall(function()
        return HttpService:JSONDecode(content)
    end)
    if not ok or type(settings) ~= "table" then
        createNotification("Config", "Config is corrupted.")
        return false
    end

    local applied, applyError = pcall(applySettings, settings)
    if not applied then
        warn("MARI-HUB config apply failed: " .. tostring(applyError))
        createNotification("Config", "Config loaded with an apply error. Check console.")
        return false
    end
    createNotification("Config", "Loaded config: " .. (cleanName ~= "" and cleanName or "n/a"))
    return true
end

local function getAutoLoadName()
    if not isfile or not readfile then
        return nil
    end
    if not isfile(CONFIG_AUTOLOAD_FILE) then
        return nil
    end

    local success, content = pcall(function()
        return readfile(CONFIG_AUTOLOAD_FILE)
    end)
    if not success then
        return nil
    end

    local name = sanitizeConfigName(content)
    if name == "" then
        return nil
    end

    return name
end

local function saveAutoLoad(name)
    local cleanName = sanitizeConfigName(name)
    if cleanName == "" then
        createNotification("Auto Load", "Select a config first!")
        return false
    end

    local ok = pcall(function()
        writefile(CONFIG_AUTOLOAD_FILE, cleanName)
    end)
    if ok then
        createNotification("Auto Load", "Auto load set to: " .. cleanName)
        return true
    end

    createNotification("Auto Load", "Failed to save auto load.")
    return false
end

local function autoLoadOnStart()
    local autoName = getAutoLoadName()
    if not autoName then
        return
    end

    for _, name in ipairs(listConfigs()) do
        if name == autoName then
            task.delay(2, function()
                loadConfig(autoName)
            end)
            return
        end
    end

    if delfile then
        pcall(function()
            delfile(CONFIG_AUTOLOAD_FILE)
        end)
    end
end

