local function getImpactParts(character)
    local result = {}
    if character then
        for _, instance in character:GetDescendants() do
            if instance:IsA("BasePart") then
                result[#result + 1] = instance
            end
        end
    end
    return result
end

local function isValidImpactTarget(player)
    local character = player and player ~= LocalPlayer and player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    return humanoid and root and humanoid.Health > 0 and root.AssemblyMass < 10000
end

local function resolveImpactTarget(text)
    text = string.lower((text or ""):gsub("%s+", ""))
    local ownRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local nearestPlayer
    local nearestDistance

    for _, player in Players:GetPlayers() do
        if isValidImpactTarget(player) then
            if text ~= "" then
                local usernameMatches = string.sub(string.lower(player.Name), 1, #text) == text
                local displayNameMatches = string.sub(string.lower(player.DisplayName), 1, #text) == text
                if usernameMatches or displayNameMatches then
                    return player
                end
            elseif ownRoot then
                local distance = (player.Character.HumanoidRootPart.Position - ownRoot.Position).Magnitude
                if not nearestDistance or distance < nearestDistance then
                    nearestPlayer = player
                    nearestDistance = distance
                end
            end
        end
    end
    return nearestPlayer
end

local function getMovementGuard()
    if not getloadedmodules then
        return nil
    end
    for _, module in ipairs(getloadedmodules()) do
        if module.Name == "MovementGuardClient" then
            local success, guard = pcall(require, module)
            if success then
                return guard
            end
        end
    end
    return nil
end

function gakuranImpact.Stop()
    impactState.running = false
end

function gakuranImpact.Fling(target)
    if impactState.running then
        return
    end

    local shouldLockTarget = typeof(target) == "Instance"
    if not shouldLockTarget then
        local targetText = target or impactTargetText
        shouldLockTarget = targetText:gsub("%s+", "") ~= ""
        target = shouldLockTarget and isValidImpactTarget(impactTargetPlayer)
            and impactTargetPlayer
            or resolveImpactTarget(targetText)
    end
    if not isValidImpactTarget(target) then
        clearImpactTarget()
        createNotification("Error", "Player does not exist.")
        return
    end
    if shouldLockTarget then
        impactTargetPlayer = target
        updateImpactTargetStatus()
    else
        impactTargetPlayer = nil
        updateImpactTargetStatus()
    end

    if flingActive then
        toggleFling(false)
    end
    impactState.running = true

    task.spawn(function()
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local targetCharacter = target.Character
        local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")

        if not humanoid or not root or not targetRoot then
            impactState.running = false
            return
        end

        if humanoid.Sit or humanoid.SeatPart then
            humanoid.Sit = false
            humanoid.Jump = true
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            task.wait(0.2)
        end

        local savedCFrame = root.CFrame
        local targetStart = targetRoot.Position
        local savedAutoRotate = humanoid.AutoRotate
        local savedPlatformStand = humanoid.PlatformStand
        local ownCollision = {}
        local targetCollision = {}

        for _, part in getImpactParts(character) do
            ownCollision[part] = part.CanCollide
        end
        for _, part in getImpactParts(targetCharacter) do
            targetCollision[part] = part.CanCollide
            part.CanCollide = true
        end

        local guard = getMovementGuard()
        if guard and guard._connection then
            guard._connection:Disconnect()
            guard._connection = nil
        end

        pcall(function()
            if sethiddenproperty then
                sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
            end
        end)

        humanoid.AutoRotate = false
        humanoid.PlatformStand = true
        humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        root.CanCollide = true

        local startedAt = os.clock()
        local frame = 0
        local peakHorizontal = 0
        local peakVertical = 0

        while impactState.running
            and os.clock() - startedAt < 3.6
            and isValidImpactTarget(target)
            and LocalPlayer.Character == character
        do
            frame = frame + 1
            targetCharacter = target.Character
            targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
            if not targetRoot then
                break
            end

            local slot = frame % 5
            local contact = (slot == 0 and targetCharacter:FindFirstChild("LowerTorso"))
                or (slot == 1 and targetCharacter:FindFirstChild("UpperTorso"))
                or (slot == 2 and targetCharacter:FindFirstChild("LeftUpperLeg"))
                or (slot == 3 and targetCharacter:FindFirstChild("RightUpperLeg"))
                or targetRoot

            for part in pairs(targetCollision) do
                if part.Parent then
                    part.CanCollide = true
                end
            end

            local away = Vector3.new(
                targetRoot.Position.X - savedCFrame.Position.X,
                0,
                targetRoot.Position.Z - savedCFrame.Position.Z
            )
            if away.Magnitude < 0.1 then
                local camera = workspace.CurrentCamera
                local look = camera and camera.CFrame.LookVector or root.CFrame.LookVector
                away = Vector3.new(look.X, 0, look.Z)
            end
            away = away.Unit

            local side = Vector3.new(-away.Z, 0, away.X)
            local lane = ((frame % 8) - 3.5) * 0.12
            local ramPosition = contact.Position - away * 0.62 + side * lane
            root.CFrame = CFrame.lookAt(ramPosition, ramPosition + away)
            root.AssemblyLinearVelocity = away * 1250000
                + side * ((frame % 2 == 0 and 1 or -1) * 35000)
                + Vector3.new(0, 2, 0)
            root.AssemblyAngularVelocity = Vector3.new(
                0,
                (frame % 2 == 0 and 1 or -1) * 1800000,
                0
            )

            local targetVelocity = targetRoot.AssemblyLinearVelocity
            local horizontalVelocity = Vector3.new(targetVelocity.X, 0, targetVelocity.Z).Magnitude
            peakHorizontal = math.max(peakHorizontal, horizontalVelocity)
            peakVertical = math.max(peakVertical, math.abs(targetVelocity.Y))
            RunService.Heartbeat:Wait()
        end

        impactState.running = false
        local displacement = targetRoot
            and Vector3.new(
                targetRoot.Position.X - targetStart.X,
                0,
                targetRoot.Position.Z - targetStart.Z
            ).Magnitude
            or 0

        gakuranImpact.LastMetrics = {
            Target = target.Name,
            HorizontalDisplacement = displacement,
            PeakHorizontalVelocity = peakHorizontal,
            PeakVerticalVelocity = peakVertical,
        }

        for part, canCollide in pairs(targetCollision) do
            if part.Parent then
                part.CanCollide = canCollide
            end
        end
        for part, canCollide in pairs(ownCollision) do
            if part.Parent then
                part.CanCollide = canCollide
            end
        end

        if guard and guard._initialized and not guard._connection then
            guard._connection = RunService.Heartbeat:Connect(function()
                guard:_step()
            end)
        end

        if root.Parent and LocalPlayer.Character == character then
            root.AssemblyAngularVelocity = Vector3.zero
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = savedCFrame * CFrame.new(0, 2.5, 0)
            humanoid.PlatformStand = savedPlatformStand
            humanoid.AutoRotate = savedAutoRotate
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end

    end)
end

function gakuranImpact.Destroy()
    impactState.running = false
    for _, connection in impactState.connections do
        connection:Disconnect()
    end
    table.clear(impactState.connections)
    if getgenv().GakuranFling == gakuranImpact then
        getgenv().GakuranFling = nil
    end
end

table.insert(connections, Players.PlayerRemoving:Connect(function(player)
    if player == impactTargetPlayer then
        clearImpactTarget()
    end
end))

