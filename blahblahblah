local function getHeartCenter()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local deathUI = pg:FindFirstChild("DeathUI")
    if not deathUI or not deathUI.Enabled then return nil end
    local frame = deathUI:FindFirstChild("Frame")
    if not frame then return nil end
    local heartButton = frame:FindFirstChild("HeartButton")
    if not heartButton or not heartButton.Visible or not heartButton.Active then return nil end
    local absPos = heartButton.AbsolutePosition
    local absSize = heartButton.AbsoluteSize
    return absPos.X + absSize.X / 2, absPos.Y + absSize.Y / 2
end

local function ensureHeartMonitor()
    if not _G.__heartAutoMonitor then
        _G.__heartAutoMonitor = true
        task.spawn(function()
            while _G.__heartAuto do
                local cx, cy = getHeartCenter()
                if cx then
                    while _G.__heartAuto do
                        local cxx, cyy = getHeartCenter()
                        if not cxx then break end
                        VirtualInputManager:SendMouseButtonEvent(cxx, cyy, 0, true, game, 1)
                        task.wait(0.05)
                        VirtualInputManager:SendMouseButtonEvent(cxx, cyy, 0, false, game, 1)
                        task.wait(0.1)
                    end
                else
                    task.wait(0.2)
                end
            end
            _G.__heartAutoMonitor = false
        end)
    end
end

