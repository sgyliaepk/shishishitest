        }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        tween(shade, 0.32, {
            BackgroundTransparency = 1,
            Position = window.restingPosition,
        }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        task.delay(0.33, function()
            if gui.Parent then
                window.transitioning = false
            end
        end)
        return window
    end

    function api:Notify(options)
        if self.destroyed then return end
        options = options or {}
        local window = self.windows[#self.windows]
        local gui = window and window.gui
        if not gui or not gui.Parent then return end
        local holder = gui:FindFirstChild("Notifications")
        if not holder then
            holder = new("Frame", {
                Name = "Notifications", AnchorPoint = Vector2.new(1, 1),
                Position = UDim2.new(1, -18, 1, -18), Size = UDim2.fromOffset(330, 420),
                BackgroundTransparency = 1, Parent = gui,
            })
            new("UIListLayout", {
                Padding = UDim.new(0, 8), VerticalAlignment = Enum.VerticalAlignment.Bottom,
                HorizontalAlignment = Enum.HorizontalAlignment.Right, SortOrder = Enum.SortOrder.LayoutOrder,
                Parent = holder,
            })
        end
        local toast = new("Frame", {
            Size = UDim2.fromOffset(0, 70), BackgroundColor3 = palette.surface,
            BackgroundTransparency = 0.03, BorderSizePixel = 0, Parent = holder,
