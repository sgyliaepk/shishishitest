local function hasSavedKeyAccess()
    if not isfile or not readfile then
        return false
    end

    if not isfile(KEY_FILE) then
        return false
    end

    local success, savedData = pcall(function()
        return readfile(KEY_FILE)
    end)

    if not success then
        return false
    end

    local expirationTime = tonumber(savedData)

    if not expirationTime then
        return false
    end

    if os.time() < expirationTime then
        return true
    end

    -- Saved key expired
    if delfile then
        pcall(function()
            delfile(KEY_FILE)
        end)
    end

    return false
end

