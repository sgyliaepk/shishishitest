function UI.autoGreen.isHoldingBasketball()
    local character = LocalPlayer.Character
    if not character then return false end
    return character:GetAttribute("ItemEquipped") == "Basketball"
        and character:GetAttribute("ItemPhase") == "Equipped"
        or character:GetAttribute("BasketballHoldingBall") == true
end

function UI.autoGreen.isGreenColor(color)
    return color.G >= 0.7
        and color.R <= 0.4
        and color.B <= 0.55
end

function UI.autoGreen.findMeterParts()
    local character = LocalPlayer.Character
    if not character then return nil end
    local roots = {character, LocalPlayer:FindFirstChild("PlayerGui")}

    for _, root in ipairs(roots) do
        if root then
            local billboard = root:FindFirstChild("BasketballShotBillboard", true)
            local meter = billboard and billboard:FindFirstChild("Meter", true)
            local marker = meter and meter:FindFirstChild("Needle", true)
            if billboard and meter and marker and meter.Visible and billboard.Enabled then
                for _, child in ipairs(meter:GetChildren()) do
                    if child:IsA("Frame")
                        and UI.autoGreen.isGreenColor(child.BackgroundColor3)
                        and child.Size.Y.Scale > 0
                    then
                        return marker, child
                    end
                end
            end

            billboard = root:FindFirstChild("BasketballShotMeterBar", true)
            local track = billboard and billboard:FindFirstChild("Track", true)
            marker = track and track:FindFirstChild("Cap", true)
            local greenWindow = track and track:FindFirstChild("Window", true)
            if billboard
                and track
                and marker
                and greenWindow
                and billboard.Enabled
                and greenWindow.Size.Y.Scale > 0
            then
                return marker, greenWindow
            end
        end
    end
    return nil
end

function UI.autoGreen.step()
    if not UI.autoGreen.enabled or not UI.autoGreen.isHoldingBasketball() then
        UI.autoGreen.releasedForShot = false
        UI.autoGreen.activeMarker = nil
        UI.autoGreen.readyAt = 0
        return
    end

    local marker, greenWindow = UI.autoGreen.findMeterParts()
    if not marker or not greenWindow then
        UI.autoGreen.releasedForShot = false
        UI.autoGreen.activeMarker = nil
        UI.autoGreen.readyAt = 0
        return
    end
    if UI.autoGreen.activeMarker ~= marker then
        UI.autoGreen.activeMarker = marker
        UI.autoGreen.readyAt = os.clock() + 0.06
        UI.autoGreen.releasedForShot = false
        return
    end
    if os.clock() < UI.autoGreen.readyAt or greenWindow.AbsoluteSize.Y < 2 then
        return
    end
    if UI.autoGreen.releasedForShot or not UserInputService:IsKeyDown(Enum.KeyCode.E) then
        return
    end

    local markerCenter = marker.AbsolutePosition.Y + marker.AbsoluteSize.Y * 0.5
    local greenTop = greenWindow.AbsolutePosition.Y
    local greenBottom = greenTop + greenWindow.AbsoluteSize.Y
    if greenTop - 1 <= markerCenter and markerCenter <= greenBottom + 1 then
        UI.autoGreen.releasedForShot = true
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end
end

function UI.autoGreen.toggle(state)
    UI.autoGreen.enabled = state == true
    UI.autoGreen.releasedForShot = false
    UI.autoGreen.activeMarker = nil
    UI.autoGreen.readyAt = 0
    if UI.autoGreen.connection then
        UI.autoGreen.connection:Disconnect()
        UI.autoGreen.connection = nil
    end
    if UI.autoGreen.enabled then
        UI.autoGreen.connection = RunService.RenderStepped:Connect(UI.autoGreen.step)
    end
end

