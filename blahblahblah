    local api = {windows = {}, connections = {}, destroyed = false, animationsEnabled = true}

    local function new(className, properties)
        local instance = Instance.new(className)
        for property, value in pairs(properties or {}) do
            if property ~= "Parent" then
                instance[property] = value
            end
        end
        if properties and properties.Parent then
            instance.Parent = properties.Parent
        end
        return instance
    end

    local function corner(parent, radius)
        return new("UICorner", {CornerRadius = UDim.new(0, radius or 8), Parent = parent})
    end

    local function stroke(parent, color, transparency)
        return new("UIStroke", {
            Color = color or palette.border,
            Transparency = transparency or 0,
            Thickness = 1,
            Parent = parent,
        })
    end

    local function tween(instance, duration, properties, easingStyle, easingDirection)
        if not api.animationsEnabled then
            for property, value in pairs(properties) do
                instance[property] = value
            end
            return nil
        end
        local animation = TweenService:Create(
            instance,
            TweenInfo.new(
                duration or 0.18,
                easingStyle or Enum.EasingStyle.Quart,
                easingDirection or Enum.EasingDirection.Out
            ),
            properties
        )
        animation:Play()
        return animation
    end

    local function connect(signal, callback, bucket)
        local connection = signal:Connect(callback)
        table.insert(bucket or api.connections, connection)
        return connection
    end

    local function invoke(callback, ...)
        if typeof(callback) ~= "function" then
            return
        end
        local ok, err = pcall(callback, ...)
        if not ok then
            warn("MARI-HUB UI callback failed: " .. tostring(err))
        end
    end

    local function setHover(button, target, normalColor, hoverColor)
        local normalUsesAccent = normalColor == palette.accent
        local normalUsesAccentSoft = normalColor == palette.accentSoft
        local hoverUsesAccent = hoverColor == palette.accent
        local hoverUsesAccentSoft = hoverColor == palette.accentSoft
        local function resolveColor(color, usesAccent, usesAccentSoft)
            if usesAccent then return palette.accent end
            if usesAccentSoft then return palette.accentSoft end
            return color
        end
        connect(button.MouseEnter, function()
            tween(target, 0.14, {
                BackgroundColor3 = resolveColor(hoverColor, hoverUsesAccent, hoverUsesAccentSoft),
            })
        end)
        connect(button.MouseLeave, function()
            tween(target, 0.14, {
                BackgroundColor3 = resolveColor(normalColor, normalUsesAccent, normalUsesAccentSoft),
            })
        end)
    end

